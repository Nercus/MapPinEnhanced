<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="animations.lua" />

    <!-- We always use an animation speed of 0.15s == 150ms to feel nice but also fast -->

    <!-- Fade In/Out -->
    <AnimationGroup name="MapPinEnhancedAnimationFadeIn"
        mixin="MapPinEnhancedAnimationVisibilityMixin"
        virtual="true">
        <Alpha fromAlpha="0" toAlpha="1" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnPlay method="OnPlayShow" />
        </Scripts>
    </AnimationGroup>

    <AnimationGroup name="MapPinEnhancedAnimationFadeInDown"
        mixin="MapPinEnhancedAnimationVisibilityMixin"
        virtual="true">
        <Alpha fromAlpha="0" toAlpha="1" duration="0.15" smoothing="IN_OUT" />
        <Translation offsetY="20" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnPlay method="OnPlayShow" />
        </Scripts>
    </AnimationGroup>

    <AnimationGroup name="MapPinEnhancedAnimationFadeInUp"
        mixin="MapPinEnhancedAnimationVisibilityMixin"
        virtual="true">
        <Alpha fromAlpha="0" toAlpha="1" duration="0.15" smoothing="IN_OUT" />
        <Translation offsetY="-20" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnPlay method="OnPlayShow" />
        </Scripts>
    </AnimationGroup>

    <AnimationGroup name="MapPinEnhancedAnimationFadeOut"
        mixin="MapPinEnhancedAnimationVisibilityMixin"
        virtual="true">
        <Alpha fromAlpha="1" toAlpha="0" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnPlay method="OnFinishedHide" />
        </Scripts>
    </AnimationGroup>

    <AnimationGroup name="MapPinEnhancedAnimationFadeOutDown"
        mixin="MapPinEnhancedAnimationVisibilityMixin"
        virtual="true">
        <Alpha fromAlpha="1" toAlpha="0" duration="0.15" smoothing="IN_OUT" />
        <Translation offsetY="-20" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnPlay method="OnFinishedHide" />
        </Scripts>
    </AnimationGroup>

    <AnimationGroup name="MapPinEnhancedAnimationFadeOutUp"
        mixin="MapPinEnhancedAnimationVisibilityMixin"
        virtual="true">
        <Alpha fromAlpha="1" toAlpha="0" duration="0.15" smoothing="IN_OUT" />
        <Translation offsetY="20" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnPlay method="OnFinishedHide" />
        </Scripts>
    </AnimationGroup>

    <!-- Spin -->
    <AnimationGroup name="MapPinEnhancedAnimationSpin"
        virtual="true" looping="REPEAT">
        <Rotation degrees="360" duration="0.5" smoothing="IN_OUT" />
    </AnimationGroup>

    <!-- Rotate -->
    <AnimationGroup name="MapPinEnhancedAnimationRotateRight90"
        mixin="MapPinEnhancedAnimationRotationMixin"
        virtual="true">
        <Rotation degrees="90" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnFinished method="OnFinishedRotateRight90" />
        </Scripts>
    </AnimationGroup>

    <AnimationGroup name="MapPinEnhancedAnimationRotateLeft90"
        mixin="MapPinEnhancedAnimationRotationMixin"
        virtual="true">
        <Rotation degrees="-90" duration="0.15" smoothing="IN_OUT" />
        <Scripts>
            <OnFinished method="OnFinishedRotateLeft90" />
        </Scripts>
    </AnimationGroup>
</Ui>
