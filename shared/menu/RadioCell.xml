<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="RadioCell.lua" />
    <Button name="MapPinEnhancedMenuRadioCellTemplate" virtual="true" mixin="MapPinEnhancedMenuRadioCellMixin" enableMouse="true" propagateMouseInput="Motion" registerForClicks="LeftButtonUp, RightButtonUp">
        <Size x="36" y="36" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="selectedBackground" hidden="true" atlas="common-button-tertiary-depressed-normal-glow">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="0" />
                        <Anchor point="BOTTOMRIGHT" x="-2" y="0" />
                    </Anchors>
                </Texture>
                <Texture parentKey="hover" hidden="true" atlas="common-button-tertiary-depressed-normal-glow" desaturated="true" alpha="0.7">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="1" y="0" />
                        <Anchor point="BOTTOMRIGHT" x="-1" y="0" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="icon">
                    <Size x="24" y="24" />
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
            <OnMouseDown method="OnMouseDown" />
            <OnHide method="OnHide" />
        </Scripts>
    </Button>
</Ui>
