<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="toggle.lua" />

    <Button name="MapPinEnhancedToggleTemplate" mixin="MapPinEnhancedToggleMixin" virtual="true" clipChildren="true">
        <Size x="50" y="25" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture setAllPoints="true" inherits="MapPinEnhancedGenericFrameTextureTemplate" scale="0.5" />
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="thumb" file="Interface/AddOns/MapPinEnhanced/assets/shared/ToggleThumb.png">
                    <Size x="16" y="16" />
                    <Anchors>
                        <Anchor point="LEFT" x="4" />
                    </Anchors>
                    <Color r="1" g="0.82" b="0" />
                </Texture>
            </Layer>
        </Layers>
        <Animations>
            <AnimationGroup parentKey="checkAnimation" setToFinalAlpha="true">
                <Alpha childKey="thumb" fromAlpha="0.5" toAlpha="1" duration="0.15" />
                <Translation childKey="thumb" offsetX="30" duration="0.15" smoothing="IN_OUT" />
                <Scripts>
                    <OnFinished>
                        self:GetParent().thumb:ClearAllPoints();
                        self:GetParent().thumb:SetPoint("LEFT", 30, 0);
                    </OnFinished>
                </Scripts>
            </AnimationGroup>
            <AnimationGroup parentKey="uncheckAnimation" setToFinalAlpha="true">
                <Alpha childKey="thumb" fromAlpha="1" toAlpha="0.5" duration="0.15" />
                <Translation childKey="thumb" offsetX="-30" duration="0.15" smoothing="IN_OUT" />
                <Scripts>
                    <OnFinished>
                        self:GetParent().thumb:ClearAllPoints();
                        self:GetParent().thumb:SetPoint("LEFT", 4, 0);
                    </OnFinished>
                </Scripts>
            </AnimationGroup>
        </Animations>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnClick method="OnClick" />
        </Scripts>
    </Button>
</Ui>
