<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="checkbox.lua" />

    <CheckButton name="MapPinEnhancedCheckboxTemplate"
        mixin="MapPinEnhancedCheckboxMixin, MapPinEnhancedThemeableMixin"
        virtual="true" propagateMouseInput="Motion">
        <Size x="25" y="25" />
        <NormalTexture parentKey="NormalTexture" atlas="generic-frame-chamfered-12d-2o"
            setAllPoints="true" />
        <HighlightTexture parentKey="HighlightTexture" atlas="generic-frame-chamfered-12d-2o"
            alphaMode="ADD" alpha="0.2" setAllPoints="true" />
        <CheckedTexture parentKey="CheckedTexture" atlas="checkmark-minimal" setAllPoints="true">
            <Animations>
                <AnimationGroup parentKey="fadeIn"
                    inherits="MapPinEnhancedAnimationFadeZoomIn" />
                <AnimationGroup parentKey="fadeOut"
                    inherits="MapPinEnhancedAnimationFadeZoomOut" />
            </Animations>
            <Scripts>
                <OnShow>
                    if self.fadeOut:IsPlaying() then
                        self.fadeOut:Stop()
                    end
                    self.fadeIn:Play()
                </OnShow>
                <OnHide>
                    if self.fadeIn:IsPlaying() then
                        self.fadeIn:Stop()
                    end
                    self.fadeOut:Play()
                </OnHide>
            </Scripts>
        </CheckedTexture>
        <DisabledCheckedTexture parentKey="CheckedTexture" atlas="checkmark-minimal-disabled"
            setAllPoints="true" />
    </CheckButton>

    <CheckButton name="MapPinEnhancedCheckboxWithLabelTemplate"
        mixin="MapPinEnhancedCheckboxMixin, MapPinEnhancedThemeableMixin"
        virtual="true" propagateMouseInput="Motion">
        <Size x="25" y="25" />
        <NormalTexture parentKey="NormalTexture" atlas="generic-frame-chamfered-12d-2o">
            <Size x="25" y="25" />
            <Anchors>
                <Anchor point="LEFT" relativePoint="LEFT" x="0" y="0" />
            </Anchors>
        </NormalTexture>
        <HighlightTexture parentKey="HighlightTexture" atlas="generic-frame-chamfered-12d-2o"
            alphaMode="ADD" alpha="0.2">
            <Size x="25" y="25" />
            <Anchors>
                <Anchor point="LEFT" relativePoint="LEFT" x="0" y="0" />
            </Anchors>
        </HighlightTexture>
        <CheckedTexture parentKey="CheckedTexture" atlas="checkmark-minimal">
            <Size x="25" y="25" />
            <Anchors>
                <Anchor point="LEFT" relativePoint="LEFT" x="0" y="0" />
            </Anchors>
            <Animations>
                <AnimationGroup parentKey="fadeIn"
                    inherits="MapPinEnhancedAnimationFadeZoomIn" />
                <AnimationGroup parentKey="fadeOut"
                    inherits="MapPinEnhancedAnimationFadeZoomOut" />
            </Animations>
            <Scripts>
                <OnShow>
                    if self.fadeOut:IsPlaying() then
                        self.fadeOut:Stop()
                    end
                    self.fadeIn:Play()
                </OnShow>
                <OnHide>
                    if self.fadeIn:IsPlaying() then
                        self.fadeIn:Stop()
                    end
                    self.fadeOut:Play()
                </OnHide>
            </Scripts>
        </CheckedTexture>
        <DisabledCheckedTexture parentKey="CheckedTexture" atlas="checkmark-minimal-disabled">
            <Size x="25" y="25" />
            <Anchors>
                <Anchor point="LEFT" relativePoint="LEFT" x="0" y="0" />
            </Anchors>
        </DisabledCheckedTexture>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentText" parentKey="text" font="GameFontNormalSmall"
                    justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT"
                            relativeKey="$parent.NormalTexture" x="3" y="0" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </CheckButton>
</Ui>
