<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="autocomplete.lua" />

    <EditBox name="MapPinEnhancedAutocompleteTemplate" mixin="MapPinEnhancedAutocompleteMixin" virtual="true" font="GameFontHighlight" autoFocus="false" multiLine="false" inherits="MapPinEnhancedInputTemplate">
        <Layers>
            <Layer level="OVERLAY">
                <Texture atlas="Spinner_Ring" hidden="true" parentKey="spinner">
                    <Size x="20" y="20" />
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="RIGHT" x="-5" />
                    </Anchors>
                    <Animations>
                        <AnimationGroup parentKey="spin" inherits="MapPinEnhancedAnimationSpin" />
                    </Animations>
                    <Scripts>
                        <OnShow>
                            self.spin:Play();
                        </OnShow>
                        <OnHide>
                            self.spin:Stop();
                        </OnHide>
                    </Scripts>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="resultsFrame" frameStrata="DIALOG" enableMouse="true" hidden="true" clampedToScreen="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" y="-4" />
                </Anchors>
                <Size x="320" y="96" />
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="background" inherits="MapPinEnhancedGenericFrameOpaqueTextureTemplate" scale="0.5">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="-9" y="6" />
                                <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="9" y="-8" />
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString parentKey="message" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="MIDDLE" text="BROWSE_NO_RESULTS">
                            <Size x="0" y="20" />
                            <Anchors>
                                <Anchor point="TOPLEFT" x="22" y="-10" />
                                <Anchor point="BOTTOMRIGHT" x="-32" y="10" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>

                <Frames>
                    <Frame parentKey="scrollBox" inherits="WowScrollBoxList" frameStrata="DIALOG" enableMouse="true">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="12" y="-10" />
                            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-32" y="10" />
                        </Anchors>
                    </Frame>
                    <EventFrame parentKey="scrollBar" inherits="MinimalScrollBar">
                        <Anchors>
                            <Anchor point="TOPRIGHT" x="-12" y="-10" />
                            <Anchor point="BOTTOMRIGHT" x="-12" y="10" />
                        </Anchors>
                    </EventFrame>
                </Frames>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnTextChanged method="OnTextChanged" />
            <OnKeyDown method="OnKeyDown" />
            <OnEditFocusLost method="OnEditFocusLost" />
        </Scripts>
    </EditBox>


    <Button name="MapPinEnhancedAutocompleteEntryTemplate" mixin="MapPinEnhancedAutocompleteEntryMixin" virtual="true">
        <Size x="1" y="24" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture setAllPoints="true">
                    <Color r="1" g="0.9" b="0.7" a="0.035" />
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString inherits="GameFontHighlightSmall" parentKey="label" justifyH="LEFT" justifyV="MIDDLE" wordwrap="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="10" />
                        <Anchor point="BOTTOMRIGHT" x="-10" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface/AddOns/MapPinEnhanced/assets/shared/GradientHorizontal.png" alphaMode="BLEND" setAllPoints="true">
            <Gradient orientation="HORIZONTAL">
                <MinColor r="1" g="1" b="1" a="1" />
                <MaxColor r="1" g="1" b="1" a="0.05" />
            </Gradient>
        </HighlightTexture>
        <ButtonText inherits="GameFontNormalSmall" />
    </Button>
</Ui>
