<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="formfield.lua" />

    <Frame name="MapPinEnhancedFormFieldTemplate" virtual="true" mixin="MapPinEnhancedFormFieldMixin" collapsesLayout="true" propagateMouseInput="Motion">
        <KeyValues>
            <KeyValue key="padding" value="0" type="number" />
            <KeyValue key="labelBottomSpacing" value="2" type="number" />
            <KeyValue key="descriptionBottomSpacing" value="4" type="number" />
            <KeyValue key="orientation" value="vertical" />
        </KeyValues>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="label" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" />
                    </Anchors>
                </FontString>
                <FontString parentKey="description" inherits="GameFontNormalSmall" wordwrap="true" justifyH="LEFT" justifyV="TOP">
                    <Color r="0.7" g="0.7" b="0.7" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.label" relativePoint="BOTTOMLEFT" y="-4" x="2" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnSizeChanged method="OnSizeChanged" />
        </Scripts>
    </Frame>
</Ui>
