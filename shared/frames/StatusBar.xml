<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="StatusBar.lua" />

    <StatusBar name="MapPinEnhancedStatusbarTemplate" mixin="MapPinEnhancedStatusbarMixin" inherits="MapPinEnhancedGenericFrameWithBottomLineTemplate" virtual="true">
        <Frames>
            <Frame parentKey="fillClip" clipChildren="true">
                <Size x="1" y="1" />
                <Anchors>
                    <Anchor point="TOPLEFT" x="3" y="-3" />
                </Anchors>
                <Frames>
                    <Frame parentKey="canvas">
                        <Anchors>
                            <Anchor point="TOPLEFT" />
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture parentKey="fill" file="Interface/AddOns/MapPinEnhanced/assets/shared/WhiteSquare.png">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" />
                                        <Anchor point="BOTTOMRIGHT" />
                                    </Anchors>
                                    <Gradient orientation="HORIZONTAL">
                                        <MinColor r="0" g="0.05" b="0.25" />
                                        <MaxColor r="0.38" g="0.49" b="0.55" />
                                    </Gradient>
                                </Texture>
                            </Layer>
                            <Layer level="ARTWORK" textureSubLevel="1">
                                <Texture parentKey="fillArt" inherits="MapPinEnhancedMapArtTemplate">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" x="2" />
                                        <Anchor point="BOTTOMRIGHT" x="-2" />
                                    </Anchors>
                                    <Gradient orientation="VERTICAL">
                                        <MinColor r="1" g="1" b="1" a="0.5" />
                                        <MaxColor r="1" g="1" b="1" a="0.5" />
                                    </Gradient>
                                </Texture>
                                <MaskTexture file="Interface/AddOns/MapPinEnhanced/assets/shared/GenericFrameMask.png" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" relativeKey="$parent.fill" />
                                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.fill" />
                                    </Anchors>
                                    <TextureSliceMargins left="4" top="4" right="4" bottom="4" />
                                    <TextureSliceMode mode="Stretched" />
                                    <MaskedTextures>
                                        <MaskedTexture childKey="fill" />
                                        <MaskedTexture childKey="fillArt" />
                                    </MaskedTextures>
                                </MaskTexture>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
            </Frame>
            <Frame parentKey="labels" setAllPoints="true">
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="name" inherits="MapPinEnhancedFontNormalTiny" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="5" y="4" relativePoint="TOPLEFT" />
                            </Anchors>
                        </FontString>
                        <FontString parentKey="progress" inherits="MapPinEnhancedFontNormalSmallOutline" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="CENTER" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Scripts>
            <OnValueChanged method="OnValueChanged" />
            <OnLoad method="OnLoad" />
            <OnHide method="OnHide" />
            <OnSizeChanged method="UpdateLayout" />
            <OnShow method="UpdateLayout" />
            <OnMinMaxChanged method="UpdateFill" />
        </Scripts>
    </StatusBar>
</Ui>
