<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="iconbutton.lua" />

    <Button name="MapPinEnhancedIconButtonTemplate" mixin="MapPinEnhancedIconButtonMixin" virtual="true">
        <KeyValues>
            <KeyValue key="iconSize" value="medium" />
        </KeyValues>
        <NormalTexture atlas="common-button-tertiary-square-normal" setAllPoints="true" />
        <PushedTexture atlas="common-button-tertiary-square-pressed" setAllPoints="true" />
        <DisabledTexture atlas="common-button-tertiary-square-disabled" setAllPoints="true" />
        <HighlightTexture atlas="common-button-tertiary-square-hover" setAllPoints="true" />

        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="iconTexture" inherits="MapPinEnhancedIconTemplate">
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnSizeChanged method="OnSizeChanged" />
            <OnMouseDown method="OnMouseDown" />
            <OnMouseUp method="OnMouseUp" />
        </Scripts>
    </Button>
</Ui>
