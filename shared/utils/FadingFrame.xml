<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="FadingFrame.lua" />
    <Frame name="MapPinEnhancedFadingFrameTemplate" virtual="true" mixin="MapPinEnhancedFadingFrameMixin">
        <Animations>
            <AnimationGroup parentKey="visibilityFadeIn" setToFinalAlpha="true">
                <Alpha parentKey="alpha" fromAlpha="0" toAlpha="1" duration="0.15" smoothing="IN_OUT" />
            </AnimationGroup>
            <AnimationGroup parentKey="visibilityFadeOut" setToFinalAlpha="true">
                <Alpha parentKey="alpha" fromAlpha="1" toAlpha="0" duration="0.15" smoothing="IN_OUT" />
                <Scripts>
                    <OnFinished>self:GetParent():FinishVisibilityHide()</OnFinished>
                </Scripts>
            </AnimationGroup>
        </Animations>
    </Frame>
</Ui>
