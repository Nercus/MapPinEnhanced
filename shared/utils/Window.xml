<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="Window.lua" />
    <Frame name="MapPinEnhancedWindowTemplate" inherits="PortraitFrameTemplate, MapPinEnhancedFadingFrameTemplate" mixin="MapPinEnhancedWindowMixin" movable="true" hidden="true" parent="UIParent" toplevel="true" virtual="true">
        <Anchors>
            <Anchor point="CENTER" />
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-5">
                <Texture alpha="0.9" parentKey="background">
                    <Color r="0" g="0" b="0" a="1" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-21" />
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2" />
                    </Anchors>
                    <TextureSliceMode mode="Stretched" />
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                </Texture>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="-4">
                <Texture parentKey="backgroundArt" inherits="MapPinEnhancedMapArtTemplate">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-21" />
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2" />
                    </Anchors>
                </Texture>
                <MaskTexture file="interface/masks/squaremask.blp" parentKey="backgroundMask" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-21" />
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2" />
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="backgroundArt" />
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="2">
                <Texture atlas="characterupdate_background" rotation="180">
                    <Size x="450" y="1" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2"/>
                        <Anchor point="BOTTOMLEFT" y="2" x="2"/>
                    </Anchors>
                    <Gradient>
                        <MaxColor r="1" g="0.82" b="0" a="0.8"/>
                        <MinColor r="0" g="0" b="0" a="0"/>
                    </Gradient>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
