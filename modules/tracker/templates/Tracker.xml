<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="Tracker.lua" />
    <Frame name="MapPinEnhancedTrackerTemplate" hidden="true" mixin="MapPinEnhancedTrackerMixin" virtual="true" toplevel="true" enableMouse="true" inherits="MapPinEnhancedFadingFrameTemplate">
        <Size x="315" y="1" />
        <Anchors>
            <Anchor point="TOPLEFT" />
        </Anchors>
        <Frames>
            <Frame parentKey="header" frameStrata="HIGH" propagateMouseInput="Motion" inherits="MapPinEnhancedTrackerHeaderTemplate" />
            <Frame parentKey="scrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.header" relativePoint="BOTTOMLEFT" x="5" y="0" />
                    <Anchor point="BOTTOMRIGHT" x="-5" y="5" />
                </Anchors>
            </Frame>
            <EventFrame parentKey="scrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.scrollBox" relativePoint="TOPRIGHT" x="5" y="-5" />
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.scrollBox" relativePoint="BOTTOMRIGHT" x="5" y="0" />
                </Anchors>
                <Animations>
                    <AnimationGroup parentKey="fadeIn" inherits="MapPinEnhancedAnimationFadeIn">
                        <KeyValues>
                            <KeyValue key="showOnPlay" value="true" type="boolean" />
                        </KeyValues>
                    </AnimationGroup>
                    <AnimationGroup parentKey="fadeOut" inherits="MapPinEnhancedAnimationFadeOut">
                        <KeyValues>
                            <KeyValue key="hideOnFinished" value="true" type="boolean" />
                        </KeyValues>
                    </AnimationGroup>
                </Animations>
            </EventFrame>
        </Frames>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="contentBackground" inherits="MapPinEnhancedGenericFrameTextureTemplate" alpha="0">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.header" relativePoint="BOTTOMLEFT" y="5" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
            <OnUpdate method="OnUpdate" />
        </Scripts>
    </Frame>
</Ui>
