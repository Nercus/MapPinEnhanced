<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="CollectionEntry.lua" />

    <Button name="MapPinEnhancedTrackerCollectionEntryTemplate" virtual="true" mixin="MapPinEnhancedTrackerCollectionEntryMixin">
        <KeyValues>
            <KeyValue key="template" value="MapPinEnhancedTrackerCollectionEntryTemplate" />
        </KeyValues>
        <Size x="300" y="45" />
        <HighlightTexture atlas="Adventures_MissionList_Highlight" alpha="0.75" desaturated="true">
            <Color r="1" g="0.82" b="0" />
            <Anchors>
                <Anchor point="TOPLEFT" x="30" y="-5" />
                <Anchor point="BOTTOMRIGHT" x="-5" y="5" />
            </Anchors>
        </HighlightTexture>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="0">
                <Texture parentKey="background" file="Interface/AddOns/MapPinEnhanced/assets/dialog/DialogBackground.png" alpha="0.75">
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                    <TextureSliceMode mode="Stretched" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="15" y="-5" />
                        <Anchor point="BOTTOMRIGHT" x="-5" y="5" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/dialog/DialogBorderGraySquare.png">
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                    <TextureSliceMode mode="Stretched" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="15" y="-5" />
                        <Anchor point="BOTTOMRIGHT" x="-5" y="5" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="0">
                <Texture parentKey="logoBG" file="interface/common/commonmaskcircle.blp">
                    <Size x="35" y="35" />
                    <Anchors>
                        <Anchor point="LEFT" x="5" />
                    </Anchors>
                    <Gradient orientation="VERTICAL">
                        <MaxColor r="0.2" g="0.2" b="0.2" />
                        <MinColor r="0" g="0" b="0" />
                    </Gradient>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture atlas="pet-list_default-ring" desaturated="true">
                    <Color r="0.7" g="0.7" b="0.7" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.logoBG" x="-9" y="9" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.logoBG" x="9" y="-9"/>
                    </Anchors>
                </Texture>
                <Texture inherits="MapPinEnhancedIconTemplate" parentKey="iconTexture">
                    <Size x="20" y="20" />
                    <KeyValues>
                        <KeyValue key="icon" value="collection" />
                    </KeyValues>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.logoBG" relativePoint="CENTER" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString inherits="GameFontNormal" parentKey="title" justifyH="LEFT" justifyV="MIDDLE">
                    <Size x="250" y="18" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.logoBG" relativePoint="TOPRIGHT" x="12" y="-3"/>
                    </Anchors>
                </FontString>
                <FontString inherits="GameFontHighlightSmall" parentKey="pinCount" justifyH="LEFT" justifyV="MIDDLE" text="12">
                    <Size x="250" y="18" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.logoBG" relativePoint="BOTTOMRIGHT" x="15" y="3" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnMouseDown method="OnMouseDown" />
        </Scripts>
    </Button>
</Ui>
