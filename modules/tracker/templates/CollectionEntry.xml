<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="CollectionEntry.lua" />

    <Button name="MapPinEnhancedTrackerCollectionEntryTemplate" virtual="true" mixin="MapPinEnhancedTrackerCollectionEntryMixin">
        <KeyValues>
            <KeyValue key="template" value="MapPinEnhancedTrackerCollectionEntryTemplate" />
        </KeyValues>
        <Size x="300" y="68" />
        <HighlightTexture atlas="Adventures_MissionList_Highlight" alpha="0.3" setAllPoints="true" />
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="0">
                <Texture parentKey="background" atlas="shop-bg-map-green" desaturated="true" setAllPoints="true">
                    <Gradient orientation="HORIZONTAL">
                        <MinColor r="1" g="1" b="1" a="0.8" />
                        <MaxColor r="1" g="1" b="1" a="0.18" />
                    </Gradient>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/dialog/DialogBorderGraySquare.png" setAllPoints="true" alpha="0.9">
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                    <TextureSliceMode mode="Stretched" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture inherits="MapPinEnhancedIconTemplate" parentKey="iconTexture">
                    <Size x="26" y="26" />
                    <KeyValues>
                        <KeyValue key="icon" value="collection" />
                    </KeyValues>
                    <Anchors>
                        <Anchor point="TOP" y="-9" />
                    </Anchors>
                </Texture>
                <FontString inherits="GameFontNormal" parentKey="title" justifyH="CENTER" justifyV="MIDDLE">
                    <Size x="250" y="18" />
                    <Anchors>
                        <Anchor point="TOP" relativeKey="$parent.iconTexture" relativePoint="BOTTOM" y="-5" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnMouseDown method="OnMouseDown" />
        </Scripts>
    </Button>
</Ui>
