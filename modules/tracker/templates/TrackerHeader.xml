<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Script file="TrackerHeader.lua" />
    <Frame name="MapPinEnhancedTrackerHeaderTemplate" mixin="MapPinEnhancedTrackerHeaderMixin"
        virtual="true" enableMouse="true" frameStrata="HIGH" propagateMouseInput="Both">
        <Size x="1" y="30" />
        <Anchors>
            <Anchor point="TOPLEFT" x="0" y="0" />
            <Anchor point="TOPRIGHT" x="0" y="0" />
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="1">
                <Texture setAllPoints="true" atlas="generic-frame-chamfered-12d-2o" alpha="0.5">
                    <TextureSliceMargins left="32" right="32" top="32" bottom="32" />
                    <TextureSliceMode mode="Stretched" />
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="title" inherits="GameFontNormal"
                    text="Map Pin Enhanced Tracker"
                    justifyH="LEFT" justifyV="MIDDLE">
                    <Size x="220" y="18" />
                    <Anchors>
                        <Anchor point="LEFT" x="30" y="0" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="closeButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="cross" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="-5" />
                </Anchors>
            </Button>
            <Button parentKey="viewButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="sets" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="-1" y="0" relativeKey="$parent.closeButton"
                        relativePoint="LEFT" />
                </Anchors>
            </Button>
            <Button parentKey="importButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="sets" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="-1" y="0" relativeKey="$parent.closeButton"
                        relativePoint="LEFT" />
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
