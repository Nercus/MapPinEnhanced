<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Script file="TrackerHeader.lua" />
    <Frame name="MapPinEnhancedTrackerHeaderTemplate" mixin="MapPinEnhancedTrackerHeaderMixin" virtual="true" enableMouse="true" frameStrata="HIGH" propagateMouseInput="Both">
        <Size x="1" y="30" />
        <Anchors>
            <Anchor point="TOPLEFT" x="0" y="0" />
            <Anchor point="TOPRIGHT" x="0" y="0" />
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="1">
                <Texture setAllPoints="true" atlas="generic-frame-chamfered-12d-2o" alpha="0.5" />
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="2">
                <Texture atlas="transmog-outfit-dividerLine">
                    <Size x="1" y="1" />
                    <Color r="1" g="0.82" b="0" a="1" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="3" y="2" />
                        <Anchor point="BOTTOMRIGHT" x="-3" y="2" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture inherits="MapPinEnhancedIconTemplate" parentKey="icon">
                    <Size x="14" y="14" />
                    <KeyValues>
                        <KeyValue key="icon" value="pin" />
                    </KeyValues>
                    <Anchors>
                        <Anchor point="LEFT" x="8" />
                    </Anchors>
                </Texture>
                <FontString parentKey="iconSeparator" inherits="GameFontNormal" text="">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.icon" x="5" />
                    </Anchors>
                </FontString>
                <FontString parentKey="title" inherits="GameFontNormal" justifyH="LEFT" justifyV="MIDDLE">
                    <Size x="220" y="18" />
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.iconSeparator" x="5" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="closeButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="cross" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="-5" />
                </Anchors>
            </Button>
            <Button parentKey="hiddenGroupsButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="tick" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="-1" y="0" relativeKey="$parent.closeButton" relativePoint="LEFT" />
                </Anchors>
            </Button>
            <Button parentKey="importButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="import" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="-1" y="0" relativeKey="$parent.hiddenGroupsButton" relativePoint="LEFT" />
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
