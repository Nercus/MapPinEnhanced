<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="GroupEntry.lua" />

    <Button name="MapPinEnhancedTrackerGroupEntryTemplate" virtual="true"
        mixin="MapPinEnhancedTrackerGroupEntryMixin">
        <KeyValues>
            <KeyValue key="template" value="MapPinEnhancedTrackerGroupEntryTemplate" />
        </KeyValues>
        <Size x="300" y="35" />
        <Frames>
            <Button parentKey="expandButton">
                <KeyValues>
                    <KeyValue key="expandedTexture" value="common-icon-minus" />
                    <KeyValue key="collapsedTexture" value="common-icon-plus" />
                </KeyValues>
                <Size x="12" y="12" />
                <NormalTexture parentKey="normalTexture"
                    atlas="common-icon-plus" setAllPoints="true" />
                <HighlightTexture parentKey="highlightTexture"
                    atlas="shop-toast-sideglow" setAllPoints="true" alpha="0.5" />
                <Anchors>
                    <Anchor point="LEFT" x="5" y="-3" />
                </Anchors>
            </Button>
        </Frames>
        <Layers>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="icon"
                    file="Interface/Icons/inv_misc_map08">
                    <Size x="20" y="10" />
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT"
                            relativeKey="$parent.expandButton" x="7" />
                    </Anchors>
                    <TexCoords left="0" right="1" top="0.25" bottom="0.75" />
                </Texture>
                <FontString parentKey="title" inherits="GameFontNormal" text="Test" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.icon" x="7" />
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="2">
                <Texture
                    atlas="UI-Journeys-Delve-rewardicon-square-frame-yellow" scale="3"
                >

                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" x="-1" y="1" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" x="1" y="-1" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <NormalTexture atlas="SquareMask" desaturated="true" horizTile="true">
            <Size x="1" y="2" />
            <Gradient orientation="HORIZONTAL">
                <MinColor r="1" g="0.82" b="0" a="1" />
                <MaxColor r="1" g="0.82" b="0" a="0" />
            </Gradient>
            <Anchors>
                <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.title" x="5" />
                <Anchor point="RIGHT" relativePoint="RIGHT" />
            </Anchors>
        </NormalTexture>
        <Scripts>
            <OnMouseDown method="OnMouseDown" />
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
        </Scripts>
    </Button>
</Ui>
