<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="GroupEntry.lua" />

    <Button name="MapPinEnhancedTrackerGroupEntryTemplate" virtual="true" mixin="MapPinEnhancedTrackerGroupEntryMixin">
        <KeyValues>
            <KeyValue key="template" value="MapPinEnhancedTrackerGroupEntryTemplate" />
        </KeyValues>
        <Size x="300" y="35" />
        <Layers>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="expandIcon" atlas="common-icon-plus">
                    <Size x="12" y="12" />
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="-3" />
                    </Anchors>
                </Texture>
                <Texture parentKey="icon" file="Interface/Icons/inv_misc_map08">
                    <Size x="16" y="16" />
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.expandIcon" x="5" />
                    </Anchors>
                </Texture>
                <MaskTexture file="interface/common/commonmaskcircle.blp" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Size x="16" y="16" />
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.expandIcon" x="5" />
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>
                <FontString parentKey="title" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.icon" x="5" />
                    </Anchors>
                </FontString>
                <Texture parentKey="line" atlas="SquareMask" desaturated="true" horizTile="true">
                    <Size x="1" y="2" />
                    <Gradient orientation="HORIZONTAL">
                        <MinColor r="1" g="0.82" b="0" a="1" />
                        <MaxColor r="1" g="0.82" b="0" a="0" />
                    </Gradient>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.title" x="5" />
                        <Anchor point="RIGHT" relativePoint="RIGHT" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="2">
                <Texture atlas="auctionhouse-itemicon-border-color" parentKey="border">
                    <Color r="1" g="0.82" b="0" a="1" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" x="-3" y="3" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" x="3" y="-3" />
                    </Anchors>
                </Texture>
            </Layer>

        </Layers>
        <Scripts>
            <OnMouseDown method="OnMouseDown" />
            <OnSizeChanged method="UpdateTitleWidth" />
        </Scripts>
    </Button>
</Ui>
