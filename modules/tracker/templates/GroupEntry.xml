<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="GroupEntry.lua" />

    <Button name="MapPinEnhancedTrackerGroupEntryTemplate" virtual="true" mixin="MapPinEnhancedTrackerGroupEntryMixin">
        <KeyValues>
            <KeyValue key="template" value="MapPinEnhancedTrackerGroupEntryTemplate" />
        </KeyValues>
        <Size x="300" y="35" />
        <Layers>

            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="expandIcon" inherits="MapPinEnhancedIconTemplate">
                    <KeyValues>
                        <KeyValue key="icon" value="plus" />
                    </KeyValues>
                    <Size x="12" y="12" />
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="-3" />
                    </Anchors>
                </Texture>
                <Texture parentKey="icon" file="Interface/Icons/inv_misc_map08">
                    <Size x="22" y="22" />
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.expandIcon" x="2" />
                    </Anchors>
                </Texture>
                <MaskTexture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallMask.png" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Size x="22" y="22" />
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.expandIcon" x="2" />
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>
                <FontString parentKey="title" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.icon" x="2" />
                    </Anchors>
                </FontString>
                <Texture parentKey="line" atlas="SquareMask" desaturated="true" horizTile="true">
                    <Size x="1" y="2" />
                    <Gradient orientation="HORIZONTAL">
                        <MinColor r="1" g="0.82" b="0" a="1" />
                        <MaxColor r="1" g="0.82" b="0" a="0" />
                    </Gradient>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.title" x="5" />
                        <Anchor point="RIGHT" relativePoint="RIGHT" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BACKGROUND">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallShadow.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallBorder.png">
                    <Color r="1" g="0.82" b="0" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallShadowInner.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="actionButtons" hidden="true">
                <Size x="45" y="20" />
                <Anchors>
                    <Anchor point="RIGHT" x="-5" y="0" />
                </Anchors>
                <Frames>
                    <Button parentKey="restoreButton" inherits="MapPinEnhancedIconButtonTemplate" propagateMouseInput="Motion">
                        <Size x="20" y="20" />
                        <KeyValues>
                            <KeyValue key="icon" value="arrowcircle" />
                        </KeyValues>
                        <Anchors>
                            <Anchor point="LEFT" />
                        </Anchors>
                    </Button>
                    <Button parentKey="clearButton" inherits="MapPinEnhancedIconButtonTemplate" propagateMouseInput="Motion">
                        <Size x="20" y="20" />
                        <KeyValues>
                            <KeyValue key="icon" value="trash" />
                        </KeyValues>
                        <Anchors>
                            <Anchor point="RIGHT" />
                        </Anchors>
                    </Button>
                </Frames>
                <Animations>
                    <AnimationGroup inherits="MapPinEnhancedAnimationFadeIn" parentKey="fadeIn">
                        <KeyValues>
                            <KeyValue key="showOnPlay" value="true" type="boolean" />
                        </KeyValues>
                    </AnimationGroup>
                    <AnimationGroup inherits="MapPinEnhancedAnimationFadeOut" parentKey="fadeOut">
                        <KeyValues>
                            <KeyValue key="hideOnFinished" value="true" type="boolean" />
                        </KeyValues>
                    </AnimationGroup>
                </Animations>
            </Frame>
        </Frames>
        <Scripts>
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
            <OnMouseDown method="OnMouseDown" />
            <OnSizeChanged method="UpdateTitleWidth" />
        </Scripts>
    </Button>
</Ui>
