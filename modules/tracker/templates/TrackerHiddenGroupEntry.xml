<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="TrackerHiddenGroupEntry.lua" />

    <Button name="MapPinEnhancedTrackerHiddenGroupEntryTemplate" virtual="true" mixin="MapPinEnhancedTrackerHiddenGroupEntryMixin">
        <Size x="1" y="26" />
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="icon" file="Interface/Icons/inv_misc_map08">
                    <Size x="22" y="22" />
                    <Anchors>
                        <Anchor point="LEFT" x="4" />
                    </Anchors>
                </Texture>
                <MaskTexture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallMask.png" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Size x="22" y="22" />
                    <Anchors>
                        <Anchor point="LEFT" x="4" />
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>

                <FontString parentKey="label" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="30" />
                        <Anchor point="BOTTOMRIGHT" x="-6" />
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="BACKGROUND">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallShadow.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallBorder.png">
                    <Color r="1" g="0.82" b="0" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/group/GroupSmallShadowInner.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface/AddOns/MapPinEnhanced/assets/shared/GradientHorizontal.png" setAllPoints="true" alpha="0.25" />
    </Button>
</Ui>
