<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="Startup.lua" />

    <Button name="MapPinEnhancedStartupButtonTemplate" inherits="MapPinEnhancedButtonTemplate" mixin="MapPinEnhancedStartupControlMixin" virtual="true">
        <Size x="110" y="30" />
        <Scripts>
            <OnClick method="OnStartupClick" />
        </Scripts>
    </Button>

    <Frame name="MapPinEnhancedStartupTemplate" inherits="MapPinEnhancedWindowTemplate" mixin="MapPinEnhancedStartupMixin" virtual="true" frameStrata="DIALOG">
        <Size x="500" y="420" />
        <KeyValues>
            <KeyValue key="compactHeight" value="350" type="number" />
            <KeyValue key="illustratedHeight" value="420" type="number" />
        </KeyValues>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="heading" inherits="GameFontNormalLarge" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="24" y="-54" />
                        <Anchor point="TOPRIGHT" x="-24" y="-54" />
                    </Anchors>
                </FontString>
                <FontString parentKey="description" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP" wordwrap="true">
                    <Size x="452" y="50" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="24" y="-82" />
                    </Anchors>
                </FontString>
                <FontString parentKey="pageNumber" inherits="GameFontDisableSmall">
                    <Anchors>
                        <Anchor point="BOTTOM" y="25" />
                    </Anchors>
                </FontString>
                <Texture parentKey="logo" file="Interface/AddOns/MapPinEnhanced/assets/LogoTransparent.png">
                    <Size x="228" y="100" />
                    <TexCoords left="0.055" right="0.945" top="0.33" bottom="0.72" />
                    <Anchors>
                        <Anchor point="TOP" y="-144" />
                    </Anchors>
                </Texture>
                <FontString parentKey="addonName" inherits="GameFontNormalLarge" justifyH="CENTER">
                    <Size x="452" y="30" />
                    <Anchors>
                        <Anchor point="TOP" y="-266" />
                    </Anchors>
                </FontString>
                <Texture parentKey="preview">
                    <Size x="320" y="180" />
                    <Anchors>
                        <Anchor point="TOP" y="-132" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="arrow" inherits="MapPinEnhancedOptionWayfinderCardTemplate" mixin="MapPinEnhancedStartupControlMixin">
                <Size x="220" y="147" />
                <KeyValues>
                    <KeyValue key="optionKey" value="Wayfinder.General.Selection" />
                    <KeyValue key="value" value="arrow" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" x="24" y="-142" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="image" file="Interface/AddOns/MapPinEnhanced/assets/options/OptionWayfinderArrow.png">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="6" y="-6" />
                                <Anchor point="BOTTOMRIGHT" x="-6" y="24" />
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick method="OnStartupClick" />
                </Scripts>
            </Button>
            <Button parentKey="floating" inherits="MapPinEnhancedOptionWayfinderCardTemplate" mixin="MapPinEnhancedStartupControlMixin">
                <Size x="220" y="147" />
                <KeyValues>
                    <KeyValue key="optionKey" value="Wayfinder.General.Selection" />
                    <KeyValue key="value" value="floating" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-24" y="-142" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="image" file="Interface/AddOns/MapPinEnhanced/assets/options/OptionWayfinderFloating.png">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="6" y="-6" />
                                <Anchor point="BOTTOMRIGHT" x="-6" y="24" />
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick method="OnStartupClick" />
                </Scripts>
            </Button>
            <Button parentKey="navigationOption" inherits="MapPinEnhancedGenericFrameWithBottomLineTemplate" mixin="MapPinEnhancedStartupControlMixin">
                <Size x="452" y="48" />
                <KeyValues>
                    <KeyValue key="optionKey" value="Wayfinder.Navigation.Enable" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOP" y="-322" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="label" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="true">
                            <Size x="360" y="36" />
                            <Anchors>
                                <Anchor point="LEFT" x="12" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Button parentKey="toggle" inherits="MapPinEnhancedToggleTemplate" enableMouse="false">
                        <Anchors>
                            <Anchor point="RIGHT" x="-12" />
                        </Anchors>
                    </Button>
                </Frames>
                <Scripts>
                    <OnClick method="OnStartupClick" />
                </Scripts>
            </Button>
            <Button parentKey="example" inherits="MapPinEnhancedStartupButtonTemplate" text="Place test pin and finish">
                <Size x="388" y="48" />
                <KeyValues>
                    <KeyValue key="action" value="example" />
                    <KeyValue key="icon" value="pin" />
                    <KeyValue key="fontSize" value="large" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOP" y="-322" />
                </Anchors>
            </Button>
            <Button parentKey="back" inherits="MapPinEnhancedStartupButtonTemplate" text="Back">
                <KeyValues>
                    <KeyValue key="action" value="back" />
                </KeyValues>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="24" y="14" />
                </Anchors>
            </Button>
            <Button parentKey="next" inherits="MapPinEnhancedStartupButtonTemplate" text="Next">
                <KeyValues>
                    <KeyValue key="action" value="next" />
                </KeyValues>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-24" y="14" />
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
