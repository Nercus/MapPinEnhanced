<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="PinColorMixin.lua" />
    <Script file="PinMenuMixin.lua" />
    <Script file="PinMouseDownMixin.lua" />
    <Script file="PinTrackingMixin.lua" />
    <Script file="PinTooltipMixin.lua" />
    <Script file="PinUtilsMixin.lua" />
    <Script file="PinProxyMixin.lua" />
    <Script file="PinMixin.lua" />


    <Button name="MapPinEnhancedPinMenuIconButton" hidden="true" virtual="true">
        <Size x="20" y="35" />
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="icon">
                    <Size x="20" y="20" />
                    <Anchors>
                        <Anchor point="CENTER"></Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture parentKey="selected" atlas="combattimeline-fx-highlight"
                    setAllPoints="true"
                    hidden="true" />
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture atlas="combattimeline-fx-pause"
                    setAllPoints="true" />
            </Layer>
        </Layers>
    </Button>
</Ui>
