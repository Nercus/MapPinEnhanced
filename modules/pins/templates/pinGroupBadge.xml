<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="pinGroupBadge.lua" />
    <Frame name="MapPinEnhancedPinGroupBadgeTemplate" mixin="MapPinEnhancedPinGroupBadgeMixin" virtual="true" hidden="true">
        <Size x="10" y="10" />
        <Layers>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="icon" setAllPoints="true" texelSnappingBias="0" snapToPixelGrid="false" />
                <MaskTexture file="interface/common/commonmaskcircle.blp" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE" setAllPoints="true">
                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="2">
                <Texture atlas="auctionhouse-itemicon-border-color">
                    <Color r="1" g="0.82" b="0" a="1" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-2" y="2" />
                        <Anchor point="BOTTOMRIGHT" x="2" y="-2" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
