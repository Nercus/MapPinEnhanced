<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="BasePin.lua" />
    <Frame name="MapPinEnhancedBasePinTemplate" mixin="MapPinEnhancedBasePinMixin" virtual="true"
        enableMouse="true" frameStrata="HIGH">
        <Size x="30" y="30" />
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="1">
                <Texture alphaMode="ADD" parentKey="pulseHighlight" hidden="true"
                    file="Interface/AddOns/MapPinEnhanced/assets/pins/PinOutlineUntracked.png"
                    setAllPoints="true">
                    <Color r="1" g="0.82" b="0" />
                    <Animations>
                        <AnimationGroup parentKey="pulse" setToFinalAlpha="true" looping="REPEAT">
                            <Scale smoothing="NONE" duration=".25" order="1" fromScaleX="1"
                                fromScaleY="1" toScaleX="1.3" toScaleY="1.3" />
                            <Alpha duration="0.25" order="1" fromAlpha="0" toAlpha=".6"
                                smoothing="IN_OUT" />
                            <Alpha duration="0.35" order="2" fromAlpha=".6" toAlpha="0"
                                smoothing="IN_OUT" />
                            <Scale duration="0.35" order="2" fromScaleX="1.2" fromScaleY="1.2"
                                toScaleX="1" toScaleY="1" smoothing="NONE" />
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="2">
                <Texture parentKey="shadow"
                    file="Interface/AddOns/MapPinEnhanced/assets/pins/PinShadow.png"
                    setAllPoints="true" texelSnappingBias="0" snapToPixelGrid="false" />
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="3">
                <Texture parentKey="background"
                    file="Interface/AddOns/MapPinEnhanced/assets/pins/PinBackground.png"
                    setAllPoints="true" texelSnappingBias="0" snapToPixelGrid="false" />
            </Layer>
            <Layer level="BORDER">
                <Texture parentKey="outline"
                    file="Interface/AddOns/MapPinEnhanced/assets/pins/PinOutlineUntracked.png"
                    setAllPoints="true" texelSnappingBias="0" snapToPixelGrid="false">
                    <Color r="0.482" g="0.314" b="0.075" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="foreground"
                    file="Interface/AddOns/MapPinEnhanced/assets/pins/PinForegroundUntracked.png"
                    setAllPoints="true" texelSnappingBias="0" snapToPixelGrid="false" />
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="icon" hidden="true" texelSnappingBias="0"
                    snapToPixelGrid="false" useAtlasSize="true">
                    <Size x="20" y="20" />
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                </Texture>
                <Texture parentKey="lock" atlas="transmog-gearSlot-transmogrified"
                    texelSnappingBias="0" rotation="45" snapToPixelGrid="false"
                    desaturated="true" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-2" y="2" />
                        <Anchor point="BOTTOMRIGHT" x="2" y="-2" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="highlight" texelSnappingBias="0" snapToPixelGrid="false"
                    file="Interface/AddOns/MapPinEnhanced/assets/pins/PinHighlight.png"
                    setAllPoints="true" />
            </Layer>
        </Layers>
    </Frame>
</Ui>
