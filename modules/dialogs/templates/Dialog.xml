<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">


    <Include file="Dialog.lua" />
    <Frame name="MapPinEnhancedDialog"
        mixin="MapPinEnhancedDialogMixin"
        movable="true" hidden="true" parent="UIParent" toplevel="true">
        <Anchors>
            <Anchor point="CENTER" />
        </Anchors>
        <Layers>
            <Layer level="BORDER">
                <Texture
                    file="Interface/AddOns/MapPinEnhanced/assets/dialog/DialogBorderGray.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-2" y="2" />
                        <Anchor point="BOTTOMRIGHT" x="2" y="-2" />
                    </Anchors>
                    <TextureSliceMode mode="Stretched" />
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                </Texture>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="0">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/logo.png" parentKey="logo">
                    <Size x="32" y="32" />
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="TOPLEFT" x="7" y="-7" />
                    </Anchors>
                </Texture>
                <MaskTexture file="interface/common/commonmaskcircle.blp"
                    vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Size x="32" y="32" />
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="TOPLEFT" x="7" y="-7" />
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="logo" />
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="1">
                <Texture atlas="charactercreate-ring-metallight">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.logo" x="-13" y="13" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.logo" x="13" y="-13" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="background" setAllPoints="true">
                <Layers>
                    <Layer level="BACKGROUND" textureSubLevel="0">
                        <Texture setAllPoints="true"
                            file="Interface/AddOns/MapPinEnhanced/assets/dialog/DialogBackground.png"
                            alpha="0.9" parentKey="bg">
                            <TextureSliceMode mode="Stretched" />
                            <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                        </Texture>
                    </Layer>
                    <Layer level="BACKGROUND" textureSubLevel="1">
                        <Texture parentKey="backgroundArt"
                            atlas="shop-bg-map-green" desaturated="true">
                            <Size x="1058" y="600" />
                            <Anchors>
                                <Anchor point="RIGHT" x="-5" />
                            </Anchors>
                            <Gradient>
                                <MinColor r="1" g="1" b="1" a="0.65" />
                                <MaxColor r="1" g="1" b="1" a="1" />
                            </Gradient>
                        </Texture>
                        <MaskTexture file="interface/masks/squaremask.blp"
                            parentKey="backgroundMask"
                            vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                            <Anchors>
                                <Anchor point="RIGHT" x="-5" />
                            </Anchors>
                            <MaskedTextures>
                                <MaskedTexture childKey="backgroundArt" />
                            </MaskedTextures>
                        </MaskTexture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnLoad>
                        self:SetFrameLevel(self:GetParent():GetFrameLevel() - 1)
                    </OnLoad>
                </Scripts>
            </Frame>
            <Frame parentKey="header">
                <Size x="1" y="30" />
                <Anchors>
                    <Anchor point="TOPLEFT" y="-5" />
                    <Anchor point="TOPRIGHT" y="-5" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture atlas="glues-characterSelect-GS-TopHUD-middle-line-selected">
                            <Size x="1" y="2" />
                            <Color r="1" g="0.82" b="0" a="1" />
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" />
                                <Anchor point="BOTTOMRIGHT" />
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString inherits="GameFontNormalLarge" setAllPoints="true"
                            justifyH="CENTER"
                            justifyV="MIDDLE" parentKey="title" />
                    </Layer>
                </Layers>
            </Frame>
            <Button name="$parentCloseButton" parentKey="CloseButton"
                inherits="UIPanelCloseButtonDefaultAnchors" frameStrata="HIGH" />
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
