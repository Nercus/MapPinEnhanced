<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="Import.lua" />
    <Frame name="MapPinEnhancedImportDialogContentTemplate" virtual="true"
        mixin="MapPinEnhancedImportDialogContentMixin">
        <Size x="500" y="450" />
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="description" inherits="GameFontHighlight" justifyH="CENTER"
                    justifyV="TOP" spacing="2">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="10" y="-20" />
                        <Anchor point="TOPRIGHT" x="-15" y="-20" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <ScrollFrame inherits="MapPinEnhancedTextareaTemplate" parentKey="textarea">
                <Size x="1" y="300" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.description"
                        relativePoint="BOTTOMLEFT" x="0" y="-20" />
                    <Anchor point="TOPRIGHT" x="0" y="-20" relativeKey="$parent.description"
                        relativePoint="BOTTOMRIGHT" />
                </Anchors>
            </ScrollFrame>
            <Frame inherits="MapPinEnhancedRadioGroupTemplate" parentKey="importTypeRadio">
                <Size x="1" y="1" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.textarea"
                        relativePoint="BOTTOMLEFT" x="0" y="-15" />
                    <Anchor point="BOTTOMLEFT" x="10" y="10" />
                </Anchors>
            </Frame>
            <Button inherits="MapPinEnhancedButtonTemplate" parentKey="cancelButton" text="Cancel">
                <Size x="100" y="30" />
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-10" y="10" />
                </Anchors>
            </Button>
            <Button inherits="MapPinEnhancedButtonTemplate" parentKey="importButton" text="Import">
                <Size x="100" y="30" />
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.cancelButton"
                        relativePoint="TOPLEFT"
                        x="-10" y="0" />
                </Anchors>
            </Button>

        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
