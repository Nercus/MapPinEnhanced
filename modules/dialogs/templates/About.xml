<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="About.lua" />
    <Frame name="MapPinEnhancedAboutDialogContentTemplate" virtual="true"
        mixin="MapPinEnhancedAboutDialogContentMixin">
        <Size x="400" y="230" />
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormalLarge" justifyH="CENTER"
                    justifyV="MIDDLE" wordwrap="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" y="-10" />
                        <Anchor point="TOPRIGHT" y="-10" />
                    </Anchors>
                </FontString>
                <FontString parentKey="version" inherits="GameFontNormal" justifyH="CENTER"
                    justifyV="MIDDLE" wordwrap="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT"
                            relativeKey="$parent.title" y="-15" />
                        <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT"
                            relativeKey="$parent.title" y="-15" />
                    </Anchors>
                </FontString>
                <FontString parentKey="build" inherits="GameFontNormal" justifyH="CENTER"
                    justifyV="MIDDLE" wordwrap="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT"
                            relativeKey="$parent.version" y="-15" />
                        <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT"
                            relativeKey="$parent.version" y="-15" />
                    </Anchors>
                </FontString>
                <FontString parentKey="thanks" inherits="GameFontNormal" justifyH="CENTER"
                    justifyV="MIDDLE" maxLines="5" wordwrap="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT"
                            relativeKey="$parent.build" y="-25" x="10" />
                        <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT"
                            relativeKey="$parent.build" y="-25" x="-10" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button inherits="MapPinEnhancedButtonTemplate" parentKey="okayButton">
                <Size x="100" y="30" />
                <Anchors>
                    <Anchor point="TOP" relativePoint="BOTTOM" y="-30" relativeKey="$parent.thanks" />
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnHide method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
