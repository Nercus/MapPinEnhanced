<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="WayfinderActionButton.lua" />

    <Button name="MapPinEnhancedWayfinderActionButtonTemplate" virtual="true" mixin="MapPinEnhancedWayfinderActionButtonMixin" inherits="SecureActionButtonTemplate" hidden="true" enableMouse="true">
        <Size x="40" y="40" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture inherits="MapPinEnhancedGenericFrameTextureTemplate">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-1" y="1" />
                        <Anchor point="BOTTOMRIGHT" x="1" y="-1" />
                    </Anchors>
                    <TextureSliceMode mode="Stretched" />
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="icon">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="3" y="-3" />
                        <Anchor point="BOTTOMRIGHT" x="-3" y="3" />
                    </Anchors>
                    <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93" />
                </Texture>
                <MaskTexture file="Interface/AddOns/MapPinEnhanced/assets/shared/GenericFrameMask.png" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="3" y="-3" />
                        <Anchor point="BOTTOMRIGHT" x="-3" y="3" />
                    </Anchors>
                    <TextureSliceMargins left="32" top="26" right="32" bottom="38" />
                    <TextureSliceMode mode="Stretched" />
                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/shared/GenericFrameMask.png">
                    <Color r="1" g="1" b="1" a="0.12" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="3" y="-3" />
                        <Anchor point="BOTTOMRIGHT" x="-3" y="3" />
                    </Anchors>
                    <TextureSliceMode mode="Stretched" />
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                </Texture>
            </Layer>
        </Layers>
        <PushedTexture file="Interface/AddOns/MapPinEnhanced/assets/shared/GenericFrameMask.png" alphaMode="ADD">
            <Color r="1" g="0.82" b="0" a="0.12" />
            <Anchors>
                <Anchor point="TOPLEFT" x="3" y="-3" />
                <Anchor point="BOTTOMRIGHT" x="-3" y="3" />
            </Anchors>
            <TextureSliceMode mode="Stretched" />
            <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
        </PushedTexture>
        <Scripts>
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
        </Scripts>
    </Button>
</Ui>
