<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="MapPinEnhancedWayfinderProgressPinTemplate" virtual="true" enableMouse="false">
        <Size x="20" y="20" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="highlight" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingFarLineBlip.png" hidden="true">
                    <Size x="28" y="28" />
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                    <Color r="1" g="0.82" b="0" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="pin" file="Interface/AddOns/MapPinEnhanced/assets/navigation/StepPin.png" setAllPoints="true" />
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="number" inherits="GameFontHighlightSmall" justifyH="CENTER" justifyV="MIDDLE" setAllPoints="true" />
            </Layer>
        </Layers>
    </Frame>
</Ui>
