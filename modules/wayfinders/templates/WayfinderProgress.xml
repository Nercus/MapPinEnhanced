<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="WayfinderProgress.lua" />
    <Frame name="MapPinEnhancedWayfinderProgressTemplate" virtual="true" hidden="true" enableMouse="true" mixin="MapPinEnhancedWayfinderProgressMixin">
        <Size x="36" y="36" />
        <Anchors>
            <Anchor point="CENTER" relativePoint="BOTTOM" y="2" />
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="1">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/shared/GenericFrameMask.png" scale="0.5">
                    <Color r="0" g="0" b="0" a="1" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-2" />
                        <Anchor point="BOTTOMRIGHT" x="2" />
                    </Anchors>
                    <TextureSliceMargins left="32" top="26" right="32" bottom="38" />
                    <TextureSliceMode mode="Stretched" />
                </Texture>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="2">
                <Texture setAllPoints="true" inherits="MapPinEnhancedGenericFrameTextureTemplate">
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" y="3" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="3">
                <Texture inherits="MapPinEnhancedBottomLineTextureTemplate" />
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="Refresh" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
