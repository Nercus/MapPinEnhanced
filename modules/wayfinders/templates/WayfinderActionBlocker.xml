<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="WayfinderActionBlocker.lua" />

    <Button name="MapPinEnhancedWayfinderActionBlockerTemplate" virtual="true" mixin="MapPinEnhancedWayfinderActionBlockerMixin" hidden="true" enableMouse="true">
        <Size x="40" y="40" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture setAllPoints="true">
                    <Color r="0.075" g="0.09" b="0.11" a="1" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="icon" desaturated="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="3" y="-3" />
                        <Anchor point="BOTTOMRIGHT" x="-3" y="3" />
                    </Anchors>
                    <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93" />
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Cooldown parentKey="cooldown" inherits="CooldownFrameTemplate" enableMouse="false">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.icon" />
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" />
                </Anchors>
            </Cooldown>
        </Frames>
        <Scripts>
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
        </Scripts>
    </Button>
</Ui>
