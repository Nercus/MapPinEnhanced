<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Texture name="MapPinEnhancedWayfinderLoadingTemplate" virtual="true" hidden="true" file="Interface\AddOns\MapPinEnhanced\assets\shared\Spinner.png">
        <Size x="32" y="32" />
        <Animations>
            <AnimationGroup parentKey="spin" looping="REPEAT">
                <Rotation degrees="-360" duration="0.5" smoothing="IN_OUT" />
            </AnimationGroup>
        </Animations>
        <Scripts>
            <OnShow>self.spin:Play()</OnShow>
            <OnHide>self.spin:Stop()</OnHide>
        </Scripts>
    </Texture>
</Ui>
