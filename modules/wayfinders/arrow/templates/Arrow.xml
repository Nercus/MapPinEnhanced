<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">


    <Include file="Arrow.lua" />
    <Frame name="MapPinEnhancedFloatingArrowTemplate" parent="UIParent" mixin="MapPinEnhancedFloatingArrowMixin" hidden="true" virtual="true" frameStrata="MEDIUM">
        <Size x="140" y="140" />
        <Anchors>
            <Anchor point="BOTTOMRIGHT" x="-500" y="500" />
        </Anchors>
        <Frames>
            <Frame parentKey="needleContainer">
                <Size x="140" y="140" />
                <Anchors>
                    <Anchor point="CENTER" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="needle" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/arrow/arrow.png" desaturated="true" setAllPoints="true">
                            <Animations>
                                <AnimationGroup inherits="MapPinEnhancedAnimationFadeIn" parentKey="fadeIn">
                                    <KeyValues>
                                        <KeyValue key="showOnPlay" value="true" />
                                    </KeyValues>
                                </AnimationGroup>
                                <AnimationGroup inherits="MapPinEnhancedAnimationFadeOut" parentKey="fadeOut">
                                    <KeyValues>
                                        <KeyValue key="hideOnFinished" value="true" />
                                    </KeyValues>
                                </AnimationGroup>
                            </Animations>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
            <Frame inherits="MapPinEnhancedBasePinTemplate" parentKey="pin" frameStrata="MEDIUM" propagateMouseInput="Both">
                <KeyValues>
                    <KeyValue key="hideShadow" value="true" type="boolean" />
                    <KeyValue key="hideHighlight" value="true" type="boolean" />
                </KeyValues>
                <Size x="40" y="40" />
                <Anchors>
                    <Anchor point="CENTER" />
                </Anchors>
            </Frame>
            <Frame parentKey="textContainer" setAllPoints="true">
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="title" inherits="GameFontHighlightSmall">
                            <Anchors>
                                <Anchor point="TOP" relativePoint="CENTER" y="-22" />
                            </Anchors>
                        </FontString>
                        <FontString parentKey="distance" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.title" y="-2" />
                            </Anchors>
                        </FontString>
                        <FontString parentKey="eta" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.distance" y="-2" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Animations>
            <AnimationGroup inherits="MapPinEnhancedAnimationFadeIn" parentKey="fadeIn">
                <KeyValues>
                    <KeyValue key="showOnPlay" value="true" />
                </KeyValues>
            </AnimationGroup>
            <AnimationGroup inherits="MapPinEnhancedAnimationFadeOut" parentKey="fadeOut">
                <KeyValues>
                    <KeyValue key="hideOnFinished" value="true" />
                </KeyValues>
            </AnimationGroup>
        </Animations>
        <Scripts>
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
