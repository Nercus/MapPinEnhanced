<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="Enhanced.lua" />
    <Frame name="MapPinEnhancedWayfinderFloatingEnhancedTemplate" virtual="true" mixin="MapPinEnhancedWayfinderFloatingEnhancedMixin" hidden="true">
        <Size x="50" y="50" />
        <Frames>
            <Frame parentKey="titleContainer">
                <Size x="10" y="20" />
                <Anchors>
                    <Anchor point="BOTTOM" relativePoint="TOP" y="-5" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND" textureSubLevel="1">
                        <Texture parentKey="titleBackground" inherits="MapPinEnhancedGenericFrameTextureTemplate" setAllPoints="true" scale="0.5" alpha="0.5">
                            <Color r="1" g="0.82" b="0" />
                        </Texture>
                    </Layer>
                    <Layer level="BACKGROUND" textureSubLevel="2">
                        <Texture file="Interface/AddOns/MapPinEnhanced/assets/shared/GradientHorizontal.png" parentKey="titleGradient">
                            <Size x="1" y="1" />
                            <Color r="1" g="0.82" b="0" />
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="5" y="1" />
                                <Anchor point="BOTTOMRIGHT" x="-5" y="1" />
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString parentKey="title" inherits="GameFontNormalSmall" justifyH="CENTER" wordwrap="false">
                            <Anchors>
                                <Anchor point="CENTER" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Frame inherits="MapPinEnhancedBasePinTemplate" parentKey="pin" frameStrata="MEDIUM" enableMouse="false">
                <Size x="30" y="30" />
                <KeyValues>
                    <KeyValue key="hideShadow" value="true" type="boolean" />
                    <KeyValue key="hideHighlight" value="true" type="boolean" />
                </KeyValues>
                <Anchors>
                    <Anchor point="CENTER" />
                </Anchors>
            </Frame>
        </Frames>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="distance" inherits="GameFontNormalSmall">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.pin" y="-5" />
                    </Anchors>
                </FontString>
                <FontString parentKey="eta" inherits="GameFontNormalSmall">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.distance" y="-5" />
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="BACKGROUND">
                <Texture parentKey="beam" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingFarLine.png">
                    <Size x="11" y="250" />
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="CENTER" relativeKey="$parent.pin" />
                    </Anchors>
                    <Gradient orientation="VERTICAL">
                        <MaxColor r="1" g="0.82" b="0" a="0" />
                        <MinColor r="1" g="0.82" b="0" a="1" />
                    </Gradient>
                </Texture>
                <Texture parentKey="needle" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/arrow/WayfinderArrow.png" desaturated="true" setAllPoints="true">
                    <Animations>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeIn" parentKey="fadeIn">
                            <KeyValues>
                                <KeyValue key="showOnPlay" value="true" />
                            </KeyValues>
                        </AnimationGroup>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeOut" parentKey="fadeOut">
                            <KeyValues>
                                <KeyValue key="hideOnFinished" value="true" />
                            </KeyValues>
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
        </Layers>
        <Animations>
            <AnimationGroup parentKey="fadeIn" inherits="MapPinEnhancedAnimationFadeZoomIn" />
            <AnimationGroup parentKey="fadeOut" inherits="MapPinEnhancedAnimationFadeZoomOut" />
        </Animations>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnEvent method="OnEvent" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
