<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="FloatingPanel.lua" />
    <Frame name="MapPinEnhancedFloatingPanelDisplayTemplate" virtual="true" hidden="true" inherits="MapPinEnhancedGenericFrameWithBottomLineTemplate, MapPinEnhancedWayfinderInstructionTemplate, MapPinEnhancedFadingFrameTemplate" mixin="MapPinEnhancedFloatingPanelMixin" enableMouse="true" frameStrata="LOW">
        <Size x="318" y="62" />
        <Anchors>
            <Anchor point="TOP" relativeTo="UIParent" y="-280" />
        </Anchors>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP" wordwrap="true">
                    <Size x="242" y="0" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="64" y="-8" />
                    </Anchors>
                </FontString>
                <FontString parentKey="text" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
                    <Color r="0.65" g="0.65" b="0.65" />
                    <Size x="242" y="0" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.title" relativePoint="BOTTOMLEFT" y="-3" />
                    </Anchors>
                </FontString>
                <FontString parentKey="distance" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size x="242" y="12" />
                    <Color r="0.65" g="0.65" b="0.65" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.text" relativePoint="BOTTOMLEFT" y="-3" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="description" inherits="MapPinEnhancedWayfinderDescriptionTemplate">
                <KeyValues>
                    <KeyValue key="maxWidth" value="210" type="number" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.title" relativePoint="BOTTOMLEFT" y="-3" />
                </Anchors>
            </Frame>
            <Frame parentKey="progress" inherits="MapPinEnhancedWayfinderProgressTemplate" />
            <Frame parentKey="pinFrame" inherits="MapPinEnhancedBasePinTemplate" enableMouse="false" frameStrata="LOW">
                <Size x="42" y="42" />
                <KeyValues>
                    <KeyValue key="hideHighlight" value="true" type="boolean" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" x="16" />
                </Anchors>
            </Frame>
            <Button parentKey="clearButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="22" y="22" />
                <KeyValues>
                    <KeyValue key="icon" value="close" />
                    <KeyValue key="tooltip" value="Clear Tracking" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-8" y="-8" />
                </Anchors>
                <Scripts>
                    <OnClick>self:GetParent():ClearTracking()</OnClick>
                </Scripts>
            </Button>
            <Button parentKey="reportButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="22" y="22" />
                <KeyValues>
                    <!-- TODO: Replace the export icon with a proper report icon. -->
                    <KeyValue key="icon" value="export" />
                    <KeyValue key="tooltip" value="Report" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOP" relativeKey="$parent.clearButton" relativePoint="BOTTOM" y="-2" />
                </Anchors>
                <Scripts>
                    <OnClick>self:GetParent():ReportNavigation()</OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnMouseDown method="OnMouseDown" />
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
        </Scripts>
    </Frame>
    <!-- Only the travel variant owns protected action controls. Both variants
         inherit the same appearance, text layout and saved-position behavior. -->
    <Frame name="MapPinEnhancedFloatingPanelTemplate" virtual="true" inherits="MapPinEnhancedFloatingPanelDisplayTemplate">
        <Frames>
            <Button parentKey="actionButton" inherits="MapPinEnhancedWayfinderActionButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="-11" />
                </Anchors>
            </Button>
            <Button parentKey="actionBlocker" inherits="MapPinEnhancedWayfinderActionBlockerTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="-11" />
                </Anchors>
            </Button>
        </Frames>
    </Frame>
</Ui>
