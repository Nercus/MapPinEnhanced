<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="FloatingSimple.lua" />
    <Frame name="MapPinEnhancedFloatingSimpleTemplate" virtual="true" mixin="MapPinEnhancedFloatingSimpleMixin" hidden="true" frameStrata="MEDIUM">
        <Size x="140" y="110" />
        <Frames>
            <Frame parentKey="clampedArrow" hidden="true">
                <Size x="80" y="80" />
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="needle" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/diamond/arrowClose.png" desaturated="true" setAllPoints="true" />
                    </Layer>
                </Layers>
            </Frame>
            <Frame inherits="MapPinEnhancedBasePinTemplate" parentKey="pin" frameStrata="MEDIUM" enableMouse="false">
                <KeyValues>
                    <KeyValue key="hideShadow" value="true" type="boolean" />
                    <KeyValue key="hideHighlight" value="true" type="boolean" />
                </KeyValues>
                <Size x="24" y="24" />
                <Anchors>
                    <Anchor point="CENTER" />
                </Anchors>
            </Frame>
            <Frame parentKey="textContainer" setAllPoints="true">
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="title" inherits="GameFontHighlightSmall">
                            <Anchors>
                                <Anchor point="TOP" relativePoint="CENTER" y="-17" />
                            </Anchors>
                        </FontString>
                        <FontString parentKey="distance" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.title" y="-2" />
                            </Anchors>
                        </FontString>
                        <FontString parentKey="eta" inherits="GameFontNormalSmall">
                            <Anchors>
                                <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.distance" y="-2" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnEvent method="OnEvent" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
