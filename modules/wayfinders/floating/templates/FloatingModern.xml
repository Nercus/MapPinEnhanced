<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="FloatingModern.lua" />
    <Frame name="MapPinEnhancedFloatingModernTemplate" virtual="true" mixin="MapPinEnhancedFloatingModernMixin">
        <Size x="50" y="50" />
        <Frames>
            <Frame inherits="MapPinEnhancedBasePinTemplate" parentKey="pin" frameStrata="MEDIUM" enableMouse="false">
                <Size x="30" y="30" />
                <KeyValues>
                    <KeyValue key="hideShadow" value="true" type="boolean" />
                    <KeyValue key="hideHighlight" value="true" type="boolean" />
                </KeyValues>
                <Anchors>
                    <Anchor point="CENTER" />
                </Anchors>
            </Frame>
        </Frames>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormalSmall">
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="TOPRIGHT" />
                    </Anchors>
                </FontString>
                <FontString parentKey="distance" inherits="GameFontNormalSmall">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.pin" y="-5" />
                    </Anchors>
                </FontString>
                <FontString parentKey="eta" inherits="GameFontNormalSmall">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.distance" y="-5" />
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="BORDER">
                <Texture atlas="generic-frame-chamfered-12d-2o">
                    <Color r="1" g="0.82" b="0" a="0.7" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.title" y="5" x="20" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.title" y="-5" x="-20" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BACKGROUND">
                <Texture parentKey="needle" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/arrow/arrow.png" desaturated="true" setAllPoints="true">
                    <Animations>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeIn" parentKey="fadeIn">
                            <KeyValues>
                                <KeyValue key="showOnPlay" value="true" />
                            </KeyValues>
                        </AnimationGroup>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeOut" parentKey="fadeOut">
                            <KeyValues>
                                <KeyValue key="hideOnFinished" value="true" />
                            </KeyValues>
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
        </Layers>
        <Animations>
            <AnimationGroup parentKey="fadeIn" inherits="MapPinEnhancedAnimationFadeZoomIn" />
            <AnimationGroup parentKey="fadeOut" inherits="MapPinEnhancedAnimationFadeZoomOut" />
        </Animations>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnEvent method="OnEvent" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
