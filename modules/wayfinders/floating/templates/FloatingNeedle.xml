<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="FloatingNeedle.lua" />

    <Frame name="MapPinEnhancedWayfinderFloatingNeedleTemplate" virtual="true" mixin="MapPinEnhancedWayfinderFloatingNeedleMixin" hidden="true">
        <Size x="64" y="64" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="fallbackBackground" file="Interface/AddOns/MapPinEnhanced/assets/shared/CircularFade.png" hidden="true" alpha="0.5">
                    <Size x="42" y="42" />
                    <Anchors>
                        <Anchor point="CENTER" y="-2"/>
                    </Anchors>
                    <Color r="0" g="0" b="0" a="0.65" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="texture" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingClampedArrow.png" desaturated="true" setAllPoints="true" />
                <Texture parentKey="fallbackTexture" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/arrow/ArrowWayfinder.png" desaturated="true" hidden="true">
                    <Size x="32" y="32" />
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                    <TexCoords left="0" right="0.0625" top="0" bottom="0.125" />
                    <Animations>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeIn" parentKey="fadeIn">
                            <KeyValues>
                                <KeyValue key="showOnPlay" value="true" />
                            </KeyValues>
                        </AnimationGroup>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeOut" parentKey="fadeOut">
                            <KeyValues>
                                <KeyValue key="hideOnFinished" value="true" />
                            </KeyValues>
                            <Scripts>
                                <OnFinished inherit="append">self:GetParent():GetParent():FinishFallbackTransition()</OnFinished>
                            </Scripts>
                        </AnimationGroup>
                    </Animations>
                </Texture>
                <Texture parentKey="fallbackCloseTexture" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/arrow/ArrowWayfinderClose.png" desaturated="true" hidden="true" alpha="0">
                    <Size x="24" y="24" />
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                    <Animations>
                        <AnimationGroup parentKey="jump" looping="REPEAT">
                            <Translation offsetY="8" duration="0.3" order="1" smoothing="IN_OUT" />
                            <Translation offsetY="-8" duration="0.3" order="2" smoothing="IN_OUT" />
                        </AnimationGroup>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeIn" parentKey="fadeIn">
                            <KeyValues>
                                <KeyValue key="showOnPlay" value="true" />
                            </KeyValues>
                        </AnimationGroup>
                        <AnimationGroup inherits="MapPinEnhancedAnimationFadeOut" parentKey="fadeOut">
                            <KeyValues>
                                <KeyValue key="hideOnFinished" value="true" />
                            </KeyValues>
                            <Scripts>
                                <OnFinished inherit="append">
                                    self:GetParent().jump:Stop()
                                    self:GetParent():GetParent():FinishFallbackTransition()
                                </OnFinished>
                            </Scripts>
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
