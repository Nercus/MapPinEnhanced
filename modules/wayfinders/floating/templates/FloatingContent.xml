<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="FloatingContent.lua" />

    <Frame name="MapPinEnhancedWayfinderFloatingContentTemplate" virtual="true" mixin="MapPinEnhancedWayfinderFloatingContentMixin" hidden="true" inherits="MapPinEnhancedFadingFrameTemplate">
        <Size x="50" y="50" />
        <Frames>
            <Frame parentKey="needle" inherits="MapPinEnhancedWayfinderFloatingNeedleTemplate">
                <Anchors>
                    <Anchor point="CENTER" />
                </Anchors>
            </Frame>
            <Frame parentKey="visual" hidden="true">
                <Size x="50" y="50" />
                <Anchors>
                    <Anchor point="CENTER" />
                </Anchors>
                <Animations>
                    <AnimationGroup parentKey="fadeIn" inherits="MapPinEnhancedAnimationFadeZoomIn" />
                    <AnimationGroup parentKey="fadeOut" inherits="MapPinEnhancedAnimationFadeZoomOut">
                        <Scripts>
                            <OnFinished>self:GetParent():GetParent():FinishPresentation()</OnFinished>
                        </Scripts>
                    </AnimationGroup>
                </Animations>
                <Frames>
                    <Frame parentKey="fallbackTitleAnchor">
                        <Size x="1" y="1" />
                        <Anchors>
                            <Anchor point="TOP" relativePoint="CENTER" y="-38" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="closePinAnchor">
                        <Size x="1" y="1" />
                        <Anchors>
                            <Anchor point="CENTER" y="60" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="pin" inherits="MapPinEnhancedBasePinTemplate" frameStrata="LOW" enableMouse="false">
                        <Size x="25" y="25" />
                        <KeyValues>
                            <KeyValue key="hideShadow" value="true" type="boolean" />
                            <KeyValue key="hideHighlight" value="true" type="boolean" />
                        </KeyValues>
                        <Anchors>
                            <Anchor point="CENTER" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="beam" inherits="MapPinEnhancedWayfinderFloatingBeamTemplate">
                        <Anchors>
                            <Anchor point="BOTTOM" relativePoint="TOP" relativeKey="$parent.pin" y="-12" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="title" inherits="MapPinEnhancedWayfinderFloatingTitleTemplate">
                        <Anchors>
                            <Anchor point="BOTTOM" relativePoint="BOTTOM" relativeKey="$parent.pin" y="3" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="readout" inherits="MapPinEnhancedWayfinderReadoutTemplate">
                        <Size x="1" y="14" />
                        <Anchors>
                            <Anchor point="BOTTOM" relativePoint="TOP" relativeKey="$parent.pin" y="-2" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="chevrons" hidden="true">
                        <Size x="34" y="35" />
                        <Anchors>
                            <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.title" y="3" />
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture parentKey="top" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingFarBottomChevron.png">
                                    <Size x="34" y="19" />
                                    <Anchors>
                                        <Anchor point="TOP" />
                                    </Anchors>
                                    <Animations>
                                        <AnimationGroup parentKey="pulse" looping="REPEAT">
                                            <Alpha fromAlpha="0.05" toAlpha="1" duration="0.6" startDelay="0" order="1" smoothing="IN_OUT" />
                                            <Alpha fromAlpha="1" toAlpha="0.05" duration="0.6" startDelay="0.15" endDelay="0.3" order="2" smoothing="IN_OUT" />
                                        </AnimationGroup>
                                    </Animations>
                                </Texture>
                                <Texture parentKey="middle" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingFarBottomChevron.png">
                                    <Size x="34" y="19" />
                                    <Anchors>
                                        <Anchor point="TOP" y="-10" />
                                    </Anchors>
                                    <Animations>
                                        <AnimationGroup parentKey="pulse" looping="REPEAT">
                                            <Alpha fromAlpha="0.05" toAlpha="1" duration="0.6" startDelay="0.15" order="1" smoothing="IN_OUT" />
                                            <Alpha fromAlpha="1" toAlpha="0.05" duration="0.6" startDelay="0.15" endDelay="0.15" order="2" smoothing="IN_OUT" />
                                        </AnimationGroup>
                                    </Animations>
                                </Texture>
                                <Texture parentKey="bottom" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingFarBottomChevron.png">
                                    <Size x="34" y="19" />
                                    <Anchors>
                                        <Anchor point="TOP" y="-20" />
                                    </Anchors>
                                    <Animations>
                                        <AnimationGroup parentKey="pulse" looping="REPEAT">
                                            <Alpha fromAlpha="0.05" toAlpha="1" duration="0.6" startDelay="0.3" order="1" smoothing="IN_OUT" />
                                            <Alpha fromAlpha="1" toAlpha="0.05" duration="0.6" startDelay="0.15" endDelay="0" order="2" smoothing="IN_OUT" />
                                        </AnimationGroup>
                                    </Animations>
                                </Texture>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
