<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="FloatingBeam.lua" />

    <Frame name="MapPinEnhancedWayfinderFloatingBeamTemplate" virtual="true" mixin="MapPinEnhancedWayfinderFloatingBeamMixin" hidden="true" inherits="MapPinEnhancedFadingFrameTemplate">
        <Size x="20" y="287" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="line" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingFarLine.png" setAllPoints="true">
                    <Gradient orientation="VERTICAL">
                        <MaxColor r="1" g="0.82" b="0" a="0.3" />
                        <MinColor r="1" g="0.82" b="0" a="1" />
                    </Gradient>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="blip" file="Interface/AddOns/MapPinEnhanced/assets/wayfinders/floating/FloatingFarLineBlip.png" texelSnappingBias="0" snapToPixelGrid="false">
                    <Size x="3" y="27" />
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="BOTTOM" />
                    </Anchors>
                    <Color r="1" g="0.82" b="0" a="0.75" />
                    <Animations>
                        <AnimationGroup looping="REPEAT" parentKey="animation">
                            <Alpha duration="0.25" order="1" fromAlpha="0" toAlpha="1" />
                            <Translation duration="3" order="1" offsetY="250"/>
                            <Alpha duration="2" order="1" fromAlpha="1" startDelay="1.0" toAlpha="0" />
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
