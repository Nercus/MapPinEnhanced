<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="FloatingTitle.lua" />

    <Frame name="MapPinEnhancedWayfinderFloatingTitleTemplate" virtual="true" mixin="MapPinEnhancedWayfinderFloatingTitleMixin" hidden="true">
        <Size x="10" y="20" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="background" inherits="MapPinEnhancedGenericFrameTextureTemplate">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-10" />
                        <Anchor point="BOTTOMRIGHT" x="10" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture parentKey="border" inherits="MapPinEnhancedGenericFrameTextureTemplate" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-10" />
                        <Anchor point="BOTTOMRIGHT" x="10" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormalSmall" justifyH="CENTER" wordwrap="false">
                    <Anchors>
                        <Anchor point="TOP" y="-5" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="description" inherits="MapPinEnhancedWayfinderDescriptionTemplate">
                <Anchors>
                    <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.title" y="-2" />
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
