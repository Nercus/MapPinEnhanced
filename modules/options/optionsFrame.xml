<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="optionsFrame.lua" />
    <Frame mixin="MapPinEnhancedOptionsFrameMixin" name="MapPinEnhancedOptionsFrame" hidden="true">

        <Layers>
            <Layer level="BACKGROUND">
                <Texture atlas="shop-bg-map-blue" setAllPoints="true" desaturated="true">
                    <Gradient orientation="HORIZONTAL">
                        <MinColor r="1" g="1" b="1" a="0" />
                        <MaxColor r="1" g="1" b="1" a="0.7" />
                    </Gradient>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="header">
                <Size x="1" y="54" />
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="title" inherits="GameFontHighlightHuge" justifyH="LEFT" justifyV="MIDDLE">
                            <Size x="320" y="24" />
                            <Anchors>
                                <Anchor point="TOPLEFT" x="16" y="-15" />
                            </Anchors>
                        </FontString>
                        <Texture atlas="Options_HorizontalDivider" useAtlasSize="true">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="16" y="0" />
                                <Anchor point="BOTTOMRIGHT" x="-16" y="0" />
                            </Anchors>
                        </Texture>
                    </Layer>

                </Layers>
                <Frames>
                    <EditBox inherits="MapPinEnhancedAutocompleteTemplate" parentKey="search">
                        <Size x="260" y="25" />
                        <Anchors>
                            <Anchor point="TOPRIGHT" x="-16" y="-13" />
                        </Anchors>
                        <KeyValues>
                            <KeyValue key="icon" value="search" />
                            <KeyValue key="placeholder" value="Search for option..." />
                        </KeyValues>
                    </EditBox>
                </Frames>
            </Frame>

            <ScrollFrame inherits="ScrollFrameTemplate" parentKey="scrollFrame" frameStrata="MEDIUM">
                <Size x="1" y="1" />
                <Anchors>
                    <Anchor point="TOPLEFT" y="-56" />
                    <Anchor point="BOTTOMRIGHT" x="-20" />
                </Anchors>
                <KeyValues>
                    <KeyValue key="scrollBarX" value="2" type="number" />
                    <KeyValue key="scrollBarTopY" value="-4" type="number" />
                    <KeyValue key="scrollBarHideIfUnscrollable" value="true" type="boolean" />
                    <KeyValue key="scrollBarHideTrackIfThumbExceedsTrack" value="true" type="boolean" />
                </KeyValues>
                <ScrollChild>
                    <Frame parentKey="Child" propagateMouseInput="Motion">
                        <Size x="634" y="1" />
                        <Anchors>
                            <Anchor point="TOPLEFT" />
                            <Anchor point="BOTTOMRIGHT" />
                        </Anchors>
                        <Frames>
                            <Frame inherits="MapPinEnhancedOptionCategoryGeneralTemplate" parentKey="General">
                                <Anchors>
                                    <Anchor point="TOPLEFT" x="0" y="-8" />
                                    <Anchor point="TOPRIGHT" x="0" y="-8" />
                                </Anchors>
                            </Frame>
                            <Frame inherits="MapPinEnhancedOptionCategoryWayfinderTemplate" parentKey="Wayfinder">
                                <Anchors>
                                    <Anchor point="TOPLEFT" relativeKey="$parent.General" relativePoint="BOTTOMLEFT" x="0" y="-8" />
                                    <Anchor point="TOPRIGHT" relativeKey="$parent.General" relativePoint="BOTTOMRIGHT" x="0" y="-8" />
                                </Anchors>
                            </Frame>
                            <Frame inherits="MapPinEnhancedOptionCategoryMiscellaneousTemplate" parentKey="Miscellaneous">
                                <Anchors>
                                    <Anchor point="TOPLEFT" relativeKey="$parent.Wayfinder" relativePoint="BOTTOMLEFT" x="0" y="-8" />
                                    <Anchor point="TOPRIGHT" relativeKey="$parent.Wayfinder" relativePoint="BOTTOMRIGHT" x="0" y="-8" />
                                </Anchors>
                            </Frame>
                        </Frames>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
        </Scripts>
    </Frame>
</Ui>
