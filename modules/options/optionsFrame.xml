<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="optionsFrame.lua" />
    <Frame mixin="MapPinEnhancedOptionsFrameMixin" name="MapPinEnhancedOptionsFrame" hidden="true">
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="title" font="GameFontNormalLarge" justifyH="CENTER"
                    justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPLEFT" y="-5" />
                        <Anchor point="TOPRIGHT" y="-5" />
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="BACKGROUND">
                <Texture atlas="shop-bg-map-blue" setAllPoints="true"
                    desaturated="true">
                    <Gradient orientation="HORIZONTAL">
                        <MinColor r="1" g="1" b="1" a="0" />
                        <MaxColor r="1" g="1" b="1" a="0.7" />
                    </Gradient>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <ScrollFrame inherits="ScrollFrameTemplate" parentKey="scrollFrame" frameStrata="MEDIUM">
                <Size x="1" y="1" />
                <Anchors>
                    <Anchor point="TOPLEFT" y="-25" />
                    <Anchor point="BOTTOMRIGHT" />
                </Anchors>
                <KeyValues>
                    <KeyValue key="scrollBarX" value="0" type="number" />
                    <KeyValue key="scrollBarTopY" value="-4" type="number" />
                    <KeyValue key="scrollBarHideIfUnscrollable" value="true" type="boolean" />
                    <KeyValue key="scrollBarHideTrackIfThumbExceedsTrack" value="true"
                        type="boolean" />
                </KeyValues>
                <ScrollChild>
                    <Frame parentKey="Child" propagateMouseInput="Motion">
                        <Size x="665" y="1" />
                        <Anchors>
                            <Anchor point="TOPLEFT" x="0" y="0" />
                            <Anchor point="BOTTOMRIGHT" x="0" y="0" />
                        </Anchors>
                        <Frames>
                            <Frame inherits="MapPinEnhancedOptionCategoryGeneralTemplate">
                                <Anchors>
                                    <Anchor point="TOPLEFT" x="0" y="-8" />
                                    <Anchor point="TOPRIGHT" x="0" y="-8" />
                                </Anchors>
                            </Frame>
                        </Frames>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>
</Ui>
