<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="Image.lua" />

    <Frame name="MapPinEnhancedImageTemplate" mixin="MapPinEnhancedImageMixin" virtual="true">
        <Size x="400" y="300" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture inherits="MapPinEnhancedGenericFrameTextureTemplate">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-5" y="5" />
                        <Anchor point="BOTTOMRIGHT" x="5" y="-5" />
                    </Anchors>
                    <TextureSliceMode mode="Stretched" />
                    <TextureSliceMargins left="30" right="30" top="30" bottom="30" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="image">
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>


                <MaskTexture file="Interface/AddOns/MapPinEnhanced/assets/shared/GenericFrameMask.png" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                    <TextureSliceMargins left="32" top="26" right="32" bottom="38" />
                    <TextureSliceMode mode="Stretched" />

                    <MaskedTextures>
                        <MaskedTexture childKey="image" />
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
