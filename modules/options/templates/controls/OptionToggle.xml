<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">


    <Frame name="MapPinEnhancedOptionToggleTemplate" virtual="true"
        inherits="MapPinEnhancedFormElementTemplate">
        <Size x="1" y="1" />
        <Frames>
            <CheckButton parentKey="child" inherits="MapPinEnhancedToggleTemplate" />
        </Frames>
        <Scripts>
            <OnMouseDown>
                self.child:Click();
            </OnMouseDown>
        </Scripts>
    </Frame>
</Ui>
