<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="OptionCheckbox.lua" />

    <Frame name="MapPinEnhancedOptionCheckboxTemplate" virtual="true" inherits="MapPinEnhancedFormElementTemplate" mixin="MapPinEnhancedOptionCheckboxMixin">
        <Size x="1" y="1" />
        <Frames>
            <CheckButton parentKey="child" inherits="MapPinEnhancedCheckboxTemplate" />
        </Frames>
        <Scripts>
            <OnMouseDown method="OnMouseDown" />
        </Scripts>
    </Frame>

    <Frame name="MapPinEnhancedOptionCheckboxWithLabelTemplate" virtual="true" inherits="MapPinEnhancedFormElementTemplate" mixin="MapPinEnhancedOptionCheckboxWithLabelMixin">
        <Size x="1" y="1" />
        <Frames>
            <CheckButton parentKey="child" inherits="MapPinEnhancedCheckboxWithLabelTemplate" />
        </Frames>
        <Scripts>
            <OnMouseDown method="OnMouseDown" />
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
