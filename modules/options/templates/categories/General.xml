<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Frame name="MapPinEnhancedOptionCategoryGeneralTemplate" virtual="true" inherits="MapPinEnhancedOptionCategoryBaseTemplate">
        <KeyValues>
            <KeyValue key="categoryName" value="General" />
        </KeyValues>
        <Frames>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate">
                <KeyValues>
                    <KeyValue key="key" value="General.Distance" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="General.Distance.ShowUnit" />
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate">
                <KeyValues>
                    <KeyValue key="key" value="General.Tracking" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionRadiogroupTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="General.Tracking.DefaultMode" />
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
