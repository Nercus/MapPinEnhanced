<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Script file="Wayfinder.lua" />
    <Frame name="MapPinEnhancedOptionCategoryWayfinderTemplate" virtual="true" inherits="MapPinEnhancedOptionCategoryBaseTemplate" mixin="MapPinEnhancedOptionCategoryWayfinderMixin">
        <KeyValues>
            <KeyValue key="categoryName" value="Wayfinder" />
        </KeyValues>
        <Frames>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate" parentKey="display">
                <KeyValues>
                    <KeyValue key="key" value="Wayfinder.Display" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionRadiogroupTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.General.Selection" />
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="searchNote" hidden="true">
                        <Size x="1" y="20" />
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString parentKey="text" inherits="GameFontHighlightSmall" justifyH="LEFT">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" />
                                        <Anchor point="TOPRIGHT" />
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate" parentKey="beam">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.Floating.ShowBeam" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate" parentKey="rotatePin">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.Arrow.RotatePin" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate" parentKey="hideBlizzard">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.General.HideBlizzardFloatingDiamond" />
                            <KeyValue key="requireReload" value="both" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.General.ShowETA" />
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate" parentKey="navigation">
                <KeyValues>
                    <KeyValue key="key" value="Wayfinder.Navigation" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionToggleTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.Navigation.Enable" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.Navigation.WorldMap" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.Navigation.Minimap" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionMultiselectTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Wayfinder.Navigation.TransportationGroups" />
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
        <Scripts>
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
