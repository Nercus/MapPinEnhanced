<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Frame name="MapPinEnhancedOptionCategoryWayfinderTemplate" virtual="true" inherits="MapPinEnhancedOptionCategoryBaseTemplate">
        <KeyValues>
            <KeyValue key="categoryName" value="Wayfinder" />
        </KeyValues>
        <Frames>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Wayfinder.Floating" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionTwoColumnTemplate">
                        <Frames>
                            <Frame parentKey="column1">
                                <Frames>
                                    <Frame inherits="MapPinEnhancedOptionToggleTemplate">
                                        <KeyValues>
                                            <KeyValue key="key" value="Wayfinder.Floating.Enable" />
                                        </KeyValues>
                                    </Frame>
                                    <Frame inherits="MapPinEnhancedOptionRadiogroupTemplate">
                                        <KeyValues>
                                            <KeyValue key="key" value="Wayfinder.Floating.Style" />
                                        </KeyValues>
                                    </Frame>
                                </Frames>
                            </Frame>
                            <Frame parentKey="column2">
                                <Size x="150" y="150" />
                                <Frames>
                                    <Frame inherits="MapPinEnhancedImageTemplate">
                                        <Size x="150" y="150" />
                                        <KeyValues>
                                            <KeyValue key="imagePath" value="Interface/AddOns/MapPinEnhanced/assets/options/wayfinderFloating.png" />
                                        </KeyValues>
                                    </Frame>
                                </Frames>
                            </Frame>
                        </Frames>
                    </Frame>
                </Frames>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Wayfinder.Arrow" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionTwoColumnTemplate">
                        <Frames>
                            <Frame parentKey="column1">
                                <Frames>
                                    <Frame inherits="MapPinEnhancedOptionToggleTemplate">
                                        <KeyValues>
                                            <KeyValue key="key" value="Wayfinder.Arrow.Enable" />
                                        </KeyValues>
                                    </Frame>
                                </Frames>
                            </Frame>
                            <Frame parentKey="column2">
                                <Size x="150" y="150" />
                                <Frames>
                                    <Frame inherits="MapPinEnhancedImageTemplate">
                                        <Size x="150" y="150" />
                                        <KeyValues>
                                            <KeyValue key="imagePath" value="Interface/AddOns/MapPinEnhanced/assets/options/wayfinderArrow.png" />
                                        </KeyValues>
                                    </Frame>
                                </Frames>
                            </Frame>
                        </Frames>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
