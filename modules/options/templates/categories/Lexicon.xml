<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Frame name="MapPinEnhancedOptionCategoryLexiconTemplate" virtual="true" inherits="MapPinEnhancedOptionCategoryBaseTemplate">
        <KeyValues>
            <KeyValue key="categoryName" value="Location Lexicon" />
            <KeyValue key="enableKey" value="Lexicon.Enable" />
        </KeyValues>
        <Frames>
            <Frame inherits="MapPinEnhancedOptionToggleTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Lexicon.Enable" />
                    <KeyValue key="padding" value="12" type="number" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionMultiselectTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Lexicon.DataTypes" />
                </KeyValues>
            </Frame>
        </Frames>
    </Frame>
</Ui>
