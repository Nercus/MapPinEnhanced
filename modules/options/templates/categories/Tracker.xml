<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Frame name="MapPinEnhancedOptionCategoryTrackerTemplate" virtual="true" inherits="MapPinEnhancedOptionCategoryBaseTemplate">
        <KeyValues>
            <KeyValue key="categoryName" value="Tracker" />
        </KeyValues>
        <Frames>
            <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Tracker.AutoShow" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Tracker.CloseAction" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Tracker.ShowCoordinates" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionSliderTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Tracker.MaximumRows" />
                    <KeyValue key="minValue" value="3" type="number" />
                    <KeyValue key="maxValue" value="12" type="number" />
                    <KeyValue key="stepValue" value="1" type="number" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionSliderTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Tracker.BackgroundOpacity" />
                    <KeyValue key="minValue" value="0" type="number" />
                    <KeyValue key="maxValue" value="100" type="number" />
                    <KeyValue key="stepValue" value="1" type="number" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionDropdownTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Tracker.Scale" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionMultiselectTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Tracker.Visibility" />
                </KeyValues>
            </Frame>
        </Frames>
    </Frame>
</Ui>
