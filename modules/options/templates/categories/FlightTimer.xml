<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Frame name="MapPinEnhancedOptionCategoryFlightTimerTemplate" virtual="true" inherits="MapPinEnhancedOptionCategoryBaseTemplate">
        <KeyValues>
            <KeyValue key="categoryName" value="Flight Timer" />
            <KeyValue key="enableKey" value="FlightTimer.Enable" />
        </KeyValues>
        <Frames>
            <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                <KeyValues>
                    <KeyValue key="key" value="FlightTimer.Enable" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                <KeyValues>
                    <KeyValue key="key" value="FlightTimer.Lock" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionDropdownTemplate">
                <KeyValues>
                    <KeyValue key="key" value="FlightTimer.Scale" />
                </KeyValues>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionColorpickerTemplate">
                <KeyValues>
                    <KeyValue key="key" value="FlightTimer.Gradient" />
                    <KeyValue key="gradient" value="true" type="boolean" />
                </KeyValues>
            </Frame>
        </Frames>
    </Frame>
</Ui>
