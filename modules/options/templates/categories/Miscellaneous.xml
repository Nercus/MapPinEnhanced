<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">


    <Frame name="MapPinEnhancedOptionCategoryMiscellaneousTemplate" virtual="true" inherits="MapPinEnhancedOptionCategoryBaseTemplate">
        <KeyValues>
            <KeyValue key="categoryName" value="Miscellaneous" />
        </KeyValues>
        <Frames>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Miscellaneous.Coords" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Miscellaneous.Coords.Enable" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionCheckboxTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Miscellaneous.Coords.Lock" />
                        </KeyValues>
                    </Frame>
                    <Frame inherits="MapPinEnhancedOptionMultiselectTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Miscellaneous.Coords.Visibility" />
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
            <Frame inherits="MapPinEnhancedOptionGroupTemplate">
                <KeyValues>
                    <KeyValue key="key" value="Miscellaneous.Tracker" />
                </KeyValues>
                <Frames>
                    <Frame inherits="MapPinEnhancedOptionMultiselectTemplate">
                        <KeyValues>
                            <KeyValue key="key" value="Miscellaneous.Tracker.Visibility" />
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
