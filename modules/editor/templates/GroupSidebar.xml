<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="GroupSidebar.lua" />

    <Frame name="MapPinEnhancedEditorGroupSidebarTemplate" virtual="true" mixin="MapPinEnhancedEditorGroupSidebarMixin">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture>
                    <Size x="1" />
                    <Color r="0.35" g="0.35" b="0.35" a="0.8" />
                    <Anchors>
                        <Anchor point="TOPRIGHT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>
                <Texture atlas="Options_HorizontalDivider">
                    <Size x="1" y="1" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.systemGroups" relativePoint="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.systemGroups" relativePoint="TOPRIGHT" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="10" y="-8" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="search" inherits="MapPinEnhancedInputTemplate">
                <Size x="198" y="24" />
                <Anchors>
                    <Anchor point="TOPLEFT" x="10" y="-32" />
                </Anchors>
            </EditBox>
            <Button parentKey="createButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="plus" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.search" relativePoint="RIGHT" x="8" />
                </Anchors>
            </Button>
            <Frame parentKey="scrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.search" relativePoint="BOTTOMLEFT" y="-8" />
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.systemGroups" relativePoint="TOPRIGHT" x="-18" y="8" />
                </Anchors>
            </Frame>
            <EventFrame parentKey="scrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.scrollBox" relativePoint="TOPRIGHT" x="4" y="-5" />
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.scrollBox" relativePoint="BOTTOMRIGHT" x="4" />
                </Anchors>
            </EventFrame>
            <Frame parentKey="systemGroups">
                <Size x="242" y="82" />
                <Anchors>
                    <Anchor point="BOTTOM" y="4" />
                </Anchors>
            </Frame>
            <Frame parentKey="systemHeader" enableMouse="true">
                <Size x="120" y="22" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.systemGroups" x="8" y="-4" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="title" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="MIDDLE">
                            <Anchors>
                                <Anchor point="LEFT" />
                            </Anchors>
                        </FontString>
                        <FontString parentKey="info" inherits="GameFontHighlightSmall" text="i" justifyH="CENTER" justifyV="MIDDLE">
                            <Size x="12" y="12" />
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.title" relativePoint="RIGHT" x="5" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="ungroupedPinsEntry" inherits="MapPinEnhancedEditorGroupSidebarEntryTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.systemGroups" x="6" y="-30" />
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
