<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="GroupSidebar.lua" />

    <Frame name="MapPinEnhancedEditorGroupSidebarTemplate" virtual="true" mixin="MapPinEnhancedEditorGroupSidebarMixin">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture atlas="generic-frame-chamfered-12d-2o" alpha="0.28">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-4" y="4" />
                        <Anchor point="BOTTOMRIGHT" x="4" y="-4" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="10" y="-8" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="search" inherits="MapPinEnhancedInputTemplate">
                <Size x="198" y="24" />
                <Anchors>
                    <Anchor point="TOPLEFT" x="10" y="-32" />
                </Anchors>
            </EditBox>
            <Button parentKey="createButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues>
                    <KeyValue key="icon" value="plus" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.search" relativePoint="RIGHT" x="8" />
                </Anchors>
            </Button>
            <Frame parentKey="scrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.search" relativePoint="BOTTOMLEFT" y="-8" />
                    <Anchor point="BOTTOMRIGHT" x="-18" y="8" />
                </Anchors>
            </Frame>
            <EventFrame parentKey="scrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.scrollBox" relativePoint="TOPRIGHT" x="4" y="-5" />
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.scrollBox" relativePoint="BOTTOMRIGHT" x="4" />
                </Anchors>
            </EventFrame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>
