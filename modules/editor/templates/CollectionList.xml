<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="CollectionList.lua" />

    <Frame name="MapPinEnhancedEditorCollectionListTemplate" virtual="true">
        <Size x="300" />
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="divider" atlas="Professions-Specializations-Divider" useAtlasSize="true" vWrapMode="REPEAT">
                    <Size x="3" />
                    <Color r="1" g="0.82" b="0" a="0.5" />
                    <Anchors>
                        <Anchor point="TOPRIGHT" y="-10" />
                        <Anchor point="BOTTOMRIGHT" y="10" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="searchBox" inherits="MapPinEnhancedInputTemplate">
                <Size x="1" y="27" />
                <KeyValues>
                    <KeyValue key="icon" value="search" />
                    <KeyValue key="placeholder" value="Search collections..." />
                    <KeyValue key="clearOnEscape" value="true" type="boolean" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" x="45" y="-12" />
                    <Anchor point="TOPRIGHT" x="-10" y="-12" />
                </Anchors>
            </EditBox>
            <Frame parentKey="scrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" x="10" y="-45" />
                    <Anchor point="BOTTOMRIGHT" x="-25" y="3" />
                </Anchors>
            </Frame>
            <EventFrame parentKey="scrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.scrollBox" relativePoint="TOPRIGHT" x="5" y="-5" />
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.scrollBox" relativePoint="BOTTOMRIGHT" x="5" y="0" />
                </Anchors>
            </EventFrame>
        </Frames>
    </Frame>
</Ui>
