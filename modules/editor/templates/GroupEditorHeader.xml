<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="GroupEditorHeader.lua" />

    <Frame name="MapPinEnhancedEditorGroupEditorHeaderTemplate" virtual="true"
        mixin="MapPinEnhancedEditorGroupEditorHeaderMixin">
        <Size x="820" y="92" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture atlas="generic-frame-chamfered-12d-2o" alpha="0.48" setAllPoints="true" />
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="icon" file="Interface/Icons/INV_Misc_QuestionMark">
                    <Size x="38" y="38" />
                    <Anchors><Anchor point="LEFT" x="14" y="4" /></Anchors>
                </Texture>
                <FontString parentKey="pinCount" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors><Anchor point="TOPLEFT" relativeKey="$parent.icon" relativePoint="BOTTOMLEFT" y="-5" /></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="nameInput" inherits="MapPinEnhancedInputTemplate">
                <Size x="225" y="24" />
                <KeyValues><KeyValue key="label" value="Name" /></KeyValues>
                <Anchors><Anchor point="TOPLEFT" x="70" y="-18" /></Anchors>
            </EditBox>
            <EditBox parentKey="iconInput" inherits="MapPinEnhancedInputTemplate">
                <Size x="265" y="24" />
                <KeyValues><KeyValue key="label" value="Icon" /></KeyValues>
                <Anchors><Anchor point="LEFT" relativeKey="$parent.nameInput" relativePoint="RIGHT" x="10" /></Anchors>
            </EditBox>
            <DropdownButton parentKey="trackingModeDropdown" inherits="MapPinEnhancedDropdownTemplate">
                <Size x="190" y="24" />
                <Anchors><Anchor point="TOPLEFT" x="105" y="-56" /></Anchors>
            </DropdownButton>
            <Frame parentKey="trackingModeLabel">
                <Size x="82" y="20" />
                <Anchors><Anchor point="RIGHT" relativeKey="$parent.trackingModeDropdown" relativePoint="LEFT" x="-8" /></Anchors>
                <Layers><Layer level="ARTWORK"><FontString parentKey="text" inherits="GameFontNormalSmall" justifyH="RIGHT" setAllPoints="true" /></Layer></Layers>
            </Frame>
            <Button parentKey="hideButton" inherits="UIPanelButtonTemplate">
                <Size x="72" y="24" />
                <Anchors><Anchor point="LEFT" relativeKey="$parent.trackingModeDropdown" relativePoint="RIGHT" x="12" /></Anchors>
            </Button>
            <Button parentKey="deleteButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues><KeyValue key="icon" value="trash" /></KeyValues>
                <Anchors><Anchor point="RIGHT" x="-14" /></Anchors>
            </Button>
        </Frames>
    </Frame>
</Ui>
