<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="GroupEditorHeader.lua" />

    <Frame name="MapPinEnhancedEditorGroupEditorHeaderTemplate" virtual="true" mixin="MapPinEnhancedEditorGroupEditorHeaderMixin">
        <Size x="820" y="64" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture file="Interface/AddOns/MapPinEnhanced/assets/shared/DividerHorizontal.png" setAllPoints="true">
                    <Size x="1" y="1" />
                    <Color r="1" g="0.82" b="0" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" y="0" />
                        <Anchor point="BOTTOMRIGHT" y="0" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="pinCount" inherits="GameFontDisableSmall" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.nameField" relativePoint="TOPRIGHT" x="-2" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="iconButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="38" y="38" />
                <KeyValues>
                    <KeyValue key="customIcon" value="true" type="boolean" />
                    <KeyValue key="iconSize" value="large" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" x="0" y="4" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <MaskTexture file="interface/common/commonmaskcircle.blp" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.iconTexture" />
                                <Anchor point="BOTTOMRIGHT" relativeKey="$parent.iconTexture" />
                            </Anchors>
                            <MaskedTextures>
                                <MaskedTexture childKey="iconTexture" />
                            </MaskedTextures>
                        </MaskTexture>
                        <Texture atlas="auctionhouse-itemicon-border-color">
                            <Color r="1" g="0.82" b="0" a="1" />
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.iconTexture" x="-5" y="5" />
                                <Anchor point="BOTTOMRIGHT" relativeKey="$parent.iconTexture" x="5" y="-5" />
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
            <Frame parentKey="nameField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="300" y="24" />
                <KeyValues>
                    <KeyValue key="labelText" value="Name" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" x="70" y="-8" />
                </Anchors>
                <Frames>
                    <EditBox parentKey="child" inherits="MapPinEnhancedInputTemplate">
                        <Size x="300" y="24" />
                    </EditBox>
                </Frames>
            </Frame>
            <Frame parentKey="trackingModeField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="240" y="24" />
                <KeyValues>
                    <KeyValue key="labelText" value="Tracking Mode" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.nameField" relativePoint="RIGHT" x="10" />
                </Anchors>
                <Frames>
                    <Frame parentKey="child" inherits="MapPinEnhancedRadioGroupTemplate">
                        <Size x="240" y="24" />
                        <KeyValues>
                            <KeyValue key="orientation" value="horizontal" />
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
            <Button parentKey="optimizeButton" inherits="MapPinEnhancedButtonTemplate" text="Optimize">
                <Size x="100" y="24" />
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.optimizeButton" relativePoint="RIGHT" x="10" />
                </Anchors>
            </Button>
            <Button parentKey="deleteButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="48" y="48" />
                <KeyValues>
                    <KeyValue key="icon" value="trash" />
                    <KeyValue key="iconSize" value="small" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="-14" />
                </Anchors>
            </Button>
            <Button parentKey="hideButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="48" y="48" />
                <KeyValues>
                    <KeyValue key="icon" value="cross" />
                    <KeyValue key="iconSize" value="small" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.deleteButton" relativePoint="LEFT" x="-6" />
                </Anchors>
            </Button>
        </Frames>
    </Frame>
</Ui>
