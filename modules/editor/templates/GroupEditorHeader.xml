<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="GroupEditorHeader.lua" />

    <Frame name="MapPinEnhancedEditorGroupEditorHeaderTemplate" virtual="true"
        mixin="MapPinEnhancedEditorGroupEditorHeaderMixin">
        <Size x="820" y="64" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture atlas="generic-frame-chamfered-12d-2o" alpha="0.48" setAllPoints="true" />
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="icon" file="Interface/Icons/INV_Misc_QuestionMark">
                    <Size x="38" y="38" />
                    <Anchors><Anchor point="LEFT" x="14" y="4" /></Anchors>
                </Texture>
                <FontString parentKey="pinCount" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors><Anchor point="TOPLEFT" relativeKey="$parent.icon" relativePoint="BOTTOMLEFT" y="-5" /></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="nameField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="190" y="24" />
                <KeyValues><KeyValue key="labelText" value="Name" /></KeyValues>
                <Anchors><Anchor point="TOPLEFT" x="70" y="-8" /></Anchors>
                <Frames><EditBox parentKey="child" inherits="MapPinEnhancedInputTemplate"><Size x="190" y="24" /></EditBox></Frames>
            </Frame>
            <Frame parentKey="iconField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="215" y="24" />
                <KeyValues><KeyValue key="labelText" value="Icon" /></KeyValues>
                <Anchors><Anchor point="LEFT" relativeKey="$parent.nameField" relativePoint="RIGHT" x="10" /></Anchors>
                <Frames><EditBox parentKey="child" inherits="MapPinEnhancedInputTemplate"><Size x="215" y="24" /></EditBox></Frames>
            </Frame>
            <Frame parentKey="trackingModeField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="165" y="24" />
                <KeyValues><KeyValue key="labelText" value="Tracking Mode" /></KeyValues>
                <Anchors><Anchor point="LEFT" relativeKey="$parent.iconField" relativePoint="RIGHT" x="10" /></Anchors>
                <Frames><DropdownButton parentKey="child" inherits="MapPinEnhancedDropdownTemplate"><Size x="165" y="24" /></DropdownButton></Frames>
            </Frame>
            <Button parentKey="hideButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues><KeyValue key="icon" value="cross" /></KeyValues>
                <Anchors><Anchor point="RIGHT" relativeKey="$parent.deleteButton" relativePoint="LEFT" x="-6" /></Anchors>
            </Button>
            <Button parentKey="deleteButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="24" y="24" />
                <KeyValues><KeyValue key="icon" value="trash" /></KeyValues>
                <Anchors><Anchor point="RIGHT" x="-14" /></Anchors>
            </Button>
        </Frames>
    </Frame>
</Ui>
