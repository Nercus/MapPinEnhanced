<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="GroupEditorPinEntry.lua" />

    <Frame name="MapPinEnhancedEditorPinDragGhostTemplate" virtual="true" frameStrata="TOOLTIP" enableMouse="false" hidden="true">
        <Size x="230" y="52" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture inherits="MapPinEnhancedGenericFrameTextureTemplate" alpha="0.92" setAllPoints="true" />
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormal" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="58" y="-8" />
                        <Anchor point="BOTTOMRIGHT" x="-70" y="8" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="pinFrame" inherits="MapPinEnhancedBasePinTemplate">
                <Anchors>
                    <Anchor point="LEFT" x="10" />
                </Anchors>
            </Frame>
        </Frames>
    </Frame>

    <Frame name="MapPinEnhancedEditorGroupEditorPinEntryTemplate" virtual="true" mixin="MapPinEnhancedEditorGroupEditorPinEntryMixin">
        <Size x="820" y="64" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture inherits="MapPinEnhancedGenericFrameTextureTemplate" alpha="0.22">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="22" y="0" />
                        <Anchor point="BOTTOMRIGHT" x="-82" y="0" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="dropLine" atlas="shop-header-menu-selected-line-middle" hidden="true">
                    <Size x="760" y="4" />
                    <Color r="1" g="0.82" b="0" a="1" />
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="dragHandle" registerForDrag="LeftButton">
                <Size x="22" y="52" />
                <Anchors>
                    <Anchor point="LEFT" x="0" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture inherits="MapPinEnhancedIconTemplate">
                            <Size x="16" y="24" />
                            <KeyValues>
                                <KeyValue key="icon" value="drag" />
                            </KeyValues>
                            <Anchors>
                                <Anchor point="CENTER" />
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
            <Frame parentKey="pinFrame" inherits="MapPinEnhancedBasePinTemplate" propagateMouseInput="Motion">
                <Anchors>
                    <Anchor point="LEFT" x="34" />
                </Anchors>
            </Frame>
            <Frame parentKey="nameField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="180" y="24" />
                <KeyValues>
                    <KeyValue key="labelText" value="Name" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" x="75" y="0" />
                </Anchors>
                <Frames>
                    <EditBox parentKey="child" inherits="MapPinEnhancedInputTemplate">
                        <Size x="180" y="24" />
                    </EditBox>
                </Frames>
            </Frame>
            <Frame parentKey="mapField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="175" y="24" />
                <KeyValues>
                    <KeyValue key="labelText" value="Map" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.nameField" relativePoint="RIGHT" x="10" />
                </Anchors>
                <Frames>
                    <EditBox parentKey="child" inherits="MapPinEnhancedAutocompleteTemplate">
                        <Size x="175" y="24" />
                    </EditBox>
                </Frames>
            </Frame>
            <Frame parentKey="xField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="100" y="24" />
                <KeyValues>
                    <KeyValue key="labelText" value="X" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.mapField" relativePoint="RIGHT" x="10" />
                </Anchors>
                <Frames>
                    <EditBox parentKey="child" inherits="MapPinEnhancedInputTemplate">
                        <Size x="100" y="24" />
                    </EditBox>
                </Frames>
            </Frame>
            <Frame parentKey="yField" inherits="MapPinEnhancedFormFieldTemplate">
                <Size x="100" y="24" />
                <KeyValues>
                    <KeyValue key="labelText" value="Y" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.xField" relativePoint="RIGHT" x="10" />
                </Anchors>
                <Frames>
                    <EditBox parentKey="child" inherits="MapPinEnhancedInputTemplate">
                        <Size x="100" y="24" />
                    </EditBox>
                </Frames>
            </Frame>
            <Button parentKey="duplicateButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="40" y="40" />
                <KeyValues>
                    <KeyValue key="icon" value="duplicate" />
                    <KeyValue key="iconSize" value="small" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.deleteButton" relativePoint="LEFT" />
                </Anchors>
            </Button>
            <Button parentKey="deleteButton" inherits="MapPinEnhancedIconButtonTemplate">
                <Size x="40" y="40" />
                <KeyValues>
                    <KeyValue key="icon" value="trash" />
                    <KeyValue key="iconSize" value="small" />
                </KeyValues>
                <Anchors>
                    <Anchor point="RIGHT" x="0" />
                </Anchors>
            </Button>
        </Frames>
    </Frame>
</Ui>
