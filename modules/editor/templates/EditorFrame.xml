<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="EditorFrame.lua" />
    <Include file="CollectionList.xml" />
    <Include file="CollectionEditor.xml" />

    <Frame name="MapPinEnhancedEditorTemplate" mixin="MapPinEnhancedEditorMixin" inherits="MapPinEnhancedWindowTemplate" enableMouse="true" parent="UIParent" movable="true" clampedToScreen="true" toplevel="true" hidden="true" virtual="true">
        <Size x="1000" y="590" />
        <KeyValues>
            <KeyValue key="windowTitle" value="Editor" />
            <KeyValue key="windowColor" value="yellow" />
        </KeyValues>
        <Frames>
            <Frame parentKey="collectionList" inherits="MapPinEnhancedEditorCollectionListTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMLEFT" />
                </Anchors>
            </Frame>
            <Frame parentKey="collectionEditor" inherits="MapPinEnhancedEditorCollectionEditorTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.collectionList" relativePoint="TOPRIGHT" />
                    <Anchor point="BOTTOMRIGHT" />
                </Anchors>
            </Frame>
        </Frames>
    </Frame>
</Ui>
