<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Include file="GroupSidebarEntry.lua" />

    <Button name="MapPinEnhancedEditorGroupSidebarEntryTemplate" virtual="true" mixin="MapPinEnhancedEditorGroupSidebarEntryMixin">
        <Size x="214" y="46" />
        <HighlightTexture atlas="UI-Frame-jailerstower-PendingButtonHighlight" setAllPoints="true" alpha="0.18" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="selectedGlow" atlas="Professions_Recipe_Active" hidden="true" setAllPoints="true">
                    <Gradient orientation="HORIZONTAL">
                        <MinColor r="1" g="0.82" b="0" a="0.55" />
                        <MaxColor r="1" g="0.82" b="0" a="0.08" />
                    </Gradient>
                </Texture>
                <Texture parentKey="dropGlow" atlas="UI-Frame-jailerstower-PendingButtonHighlight" hidden="true" setAllPoints="true">
                    <Color r="0.2" g="0.8" b="1" a="0.85" />
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="icon" file="Interface/Icons/INV_Misc_QuestionMark">
                    <Size x="28" y="28" />
                    <Anchors>
                        <Anchor point="LEFT" x="8" />
                    </Anchors>
                </Texture>
                <MaskTexture atlas="UI-HUD-CoolDownManager-Mask">
                    <Size x="28" y="28" />
                    <Anchors>
                        <Anchor point="LEFT" x="8" />
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>
                <FontString parentKey="name" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" relativePoint="TOPRIGHT" x="8" y="-1" />
                        <Anchor point="RIGHT" x="-8" />
                    </Anchors>
                </FontString>
                <FontString parentKey="detail" inherits="GameFontDisableSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.name" relativePoint="BOTTOMLEFT" y="-2" />
                        <Anchor point="RIGHT" x="-8" />
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="OVERLAY">
                <Texture atlas="UI-HUD-CoolDownManager-IconOverlay">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon" x="-6" y="5" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon" x="6" y="-5" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick method="OnClick" />
            <OnMouseUp method="OnMouseUp" />
            <OnReceiveDrag method="OnReceiveDrag" />
        </Scripts>
    </Button>
</Ui>
