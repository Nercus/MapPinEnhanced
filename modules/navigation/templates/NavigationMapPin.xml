<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Script file="NavigationMapPin.lua" />
    <Frame name="MapPinEnhancedNavigationMapPinTemplate" virtual="true" mixin="MapPinEnhancedNavigationMapPinMixin" hidden="true" enableMouse="false">
        <Size x="18" y="18" />
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="circle" file="Interface/AddOns/MapPinEnhanced/assets/navigation/StepPin.png" hidden="true" setAllPoints="true" />
            </Layer>
            <Layer level="ARTWORK">
                <Line parentKey="line" thickness="2" hidden="true">
                    <Color r="1" g="1" b="1" a="1" />
                </Line>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="number" inherits="GameFontNormalSmall" hidden="true" justifyH="CENTER" justifyV="MIDDLE" setAllPoints="true">
                    <Color r="1" g="1" b="1" />
                    <Shadow>
                        <Offset x="1" y="-1" />
                        <Color r="0" g="0" b="0" a="1" />
                    </Shadow>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
            <OnShow method="OnShow" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>
