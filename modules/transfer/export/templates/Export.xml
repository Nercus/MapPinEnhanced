<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Include file="Export.lua" />
    <Frame name="MapPinEnhancedExportWindowTemplate" inherits="MapPinEnhancedWindowTemplate" virtual="true" mixin="MapPinEnhancedExportWindowMixin">
        <Size x="650" y="450" />
        <KeyValues>
            <KeyValue key="windowTitle" value="Export" />
        </KeyValues>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="description" inherits="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="25" y="-64" />
                        <Anchor point="TOPRIGHT" x="-25" y="-64" />
                    </Anchors>
                </FontString>
                <FontString parentKey="prefixLabel" inherits="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.description" relativePoint="BOTTOMLEFT" x="5" y="-40" />
                    </Anchors>
                </FontString>
                <FontString parentKey="warning" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP" hidden="true">
                    <Size x="1" y="32" />
                    <Color r="1" g="0.45" b="0.1" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="25" y="10" />
                        <Anchor point="BOTTOMRIGHT" x="-25" y="10" />
                    </Anchors>
                </FontString>
                <FontString parentKey="summary" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size x="1" y="16" />
                    <Anchors>
                        <Anchor relativePoint="TOPLEFT" point="BOTTOMLEFT" y="10" relativeKey="$parent.warning"/>
                        <Anchor relativePoint="TOPRIGHT" point="BOTTOMRIGHT" y="10" relativeKey="$parent.warning" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame inherits="MapPinEnhancedRadioGroupTemplate" parentKey="exportTypeRadio">
                <KeyValues>
                    <KeyValue key="orientation" value="horizontal" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.description" relativePoint="BOTTOMLEFT" x="0" y="-5" />
                </Anchors>
            </Frame>
            <Frame inherits="MapPinEnhancedRadioGroupTemplate" parentKey="prefixRadio">
                <KeyValues>
                    <KeyValue key="orientation" value="horizontal" />
                </KeyValues>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.prefixLabel" relativePoint="RIGHT" x="12" y="2" />
                </Anchors>
            </Frame>
            <ScrollFrame inherits="MapPinEnhancedTextareaTemplate" parentKey="textarea">
                <Size x="580" y="205" />
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="0" y="-10" relativeKey="$parent.prefixLabel" />
                    <Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" x="0" y="10" relativeKey="$parent.summary" />
                </Anchors>
            </ScrollFrame>
        </Frames>
    </Frame>
</Ui>
